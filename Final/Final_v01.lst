GAMS 54.3.1  61154be4 Aug 21, 2026          DAX-DAC arm 64bit/macOS - 11/24/26 11:43:11 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1   
   2  ** Final Project - DSI export fee on Indonesian Ferronickel
   3  ** Prepared by Faiz Al Harkan
   4   
   5  ** Phase 1 - Welfare analysis and fee incidence
   6  ** Assumption: 1 commodity, 1 period, competitive exporters
   7  ** Using 2025 export data; elasticities and fees are assumed
   8  ** X = exports (million metric tons); P = USD per ton of product
   9  ** Revenue, cost, surplus, and profit are in million USD
  10  ** CS refers to surplus under foreign residual demand.
  11  ** Total surplus excludes real DSI operating costs and governance benefits.
  12   
  13  option decimals = 6;
  14   
  15  * ----------------------------------------
  16  ** 1. Input Values and Elasticities
  17  * ----------------------------------------
  18   
  19  scalar
  20     vbar "2025 export value [million USD]" /16385.06673/
  21     xbar "2025 export quantity [million tons]" /11.5556/
  22     pbar "average export price [USD/ton]"
  23     e_r  "residual demand elasticity [unitless]" /-2/
  24     e_s  "supply elasticity [unitless]" /1/;
  25   
  26  * Average price from 2025 export data
  27  pbar = vbar / xbar;
  28   
  29  display vbar, xbar, pbar, e_r, e_s;
  30   
  31  * ----------------------------------------
  32  ** 2. Determine Inverse Residual Demand and Marginal Cost
  33  * ----------------------------------------
  34   
  35  * P(X) = a + bX
  36  * MC(X) = c + dX
  37   
  38  scalar
  39     a "demand intercept"
  40     b "demand slope"
  41     c "marginal cost intercept"
  42     d "marginal cost slope";
  43   
  44  * Calibrate using price, quantity, and elasticities
  45  b = pbar / (e_r * xbar);
  46  a = pbar - b * xbar;
  47   
  48  d = pbar / (e_s * xbar);
  49  c = pbar - d * xbar;
  50   
  51  display a, b, c, d;
  52   
  53  * ----------------------------------------
  54  ** 3. Direct Selling - No Fee
  55  * ----------------------------------------
  56   
  57  * Competitive market, where P = MC
  58   
  59  positive variable X "export quantity";
  60  variable equilibrium_potential "equilibrium potential, not national welfare";
  61   
  62  equation eq_surplus;
  63   
  64  eq_surplus..
  65     equilibrium_potential =e=
  66       a*X + 0.5*b*sqr(X)
  67     - c*X - 0.5*d*sqr(X);
  68   
  69  model direct_selling /eq_surplus/;
  70   
  71  X.l = xbar;
  72   
  73  solve direct_selling using qcp maximizing equilibrium_potential;
  74   
  75  abort$(direct_selling.solvestat ne 1 or
  76        (direct_selling.modelstat ne 1 and direct_selling.modelstat ne 2))
  77     "No-fee solve did not terminate at an optimum";
  78   
  79  * Calculate baseline price, exporter surplus, and welfare
  80  scalar
  81     exports_base "baseline export quantity [Mt]"
  82     price_base "baseline buyer and exporter price [USD/ton]"
  83     exporter_surplus_base "baseline producer surplus [million USD]"
  84     consumer_surplus_base "baseline residual buyer surplus [million USD]"
  85     total_surplus_base "baseline modeled market surplus [million USD]";
  86   
  87  exports_base = X.l;
  88  price_base = a + b*exports_base;
  89   
  90  exporter_surplus_base = price_base*exports_base
  91                        - (c*exports_base + 0.5*d*sqr(exports_base));
  92   
  93  * Phase 1: consumer surplus and total surplus
  94  consumer_surplus_base = -0.5*b*sqr(exports_base);
  95   
  96  total_surplus_base = consumer_surplus_base + exporter_surplus_base;
  97   
  98  display exports_base, price_base, exporter_surplus_base,
  99          consumer_surplus_base, total_surplus_base;
 100   
 101  * ----------------------------------------
 102  ** 4. Direct Selling - With DSI Fee
 103  * ----------------------------------------
 104   
 105  * Exporters pay a hypothetical fee to DSI for monitoring and verification.
 106  * DSI revenue is not the same as DSI profit.
 107  * The fee is deducted in the equilibrium potential to obtain P - fee = MC.
 108  * It is added back in total surplus because it is a transfer before costs.
 109   
 110  scalar fee "DSI fee [USD/ton]" /5/;
 111   
 112  equation eq_fee;
 113   
 114  eq_fee..
 115     equilibrium_potential =e=
 116       a*X + 0.5*b*sqr(X)
 117     - c*X - 0.5*d*sqr(X)
 118     - fee*X;
 119   
 120  model with_dsi_fee /eq_fee/;
 121   
 122  X.l = xbar;
 123   
 124  solve with_dsi_fee using qcp maximizing equilibrium_potential;
 125   
 126  abort$(with_dsi_fee.solvestat ne 1 or
 127        (with_dsi_fee.modelstat ne 1 and with_dsi_fee.modelstat ne 2))
 128     "Main fee solve did not terminate at an optimum";
 129   
 130  scalar
 131     exports_fee "export quantity with fee [Mt]"
 132     price_fee "foreign buyer price [USD/ton]"
 133     net_price_fee "net exporter price [USD/ton]"
 134     exporter_surplus_fee "producer surplus [million USD]"
 135     dsi_revenue_fee "DSI gross revenue [million USD]"
 136     consumer_surplus_fee "residual buyer surplus [million USD]"
 137     total_surplus_fee "modeled market surplus before DSI costs [million USD]"
 138     change_cs "change in consumer surplus [million USD]"
 139     change_ps "change in producer surplus [million USD]"
 140     change_ts "change in total surplus [million USD]"
 141     deadweight_loss "loss in total surplus before DSI costs [million USD]"
 142     buyer_incidence "buyer share of per-ton fee [percent]"
 143     exporter_incidence "exporter share of per-ton fee [percent]"
 144     check_eq "fee-adjusted equilibrium residual [USD/ton]";
 145   
 146  exports_fee = X.l;
 147  price_fee = a + b*exports_fee;
 148  net_price_fee = price_fee - fee;
 149   
 150  exporter_surplus_fee = net_price_fee*exports_fee
 151                      - (c*exports_fee + 0.5*d*sqr(exports_fee));
 152   
 153  dsi_revenue_fee = fee*exports_fee;
 154   
 155  * Phase 1: welfare with DSI fee
 156  consumer_surplus_fee = -0.5*b*sqr(exports_fee);
 157   
 158  total_surplus_fee = consumer_surplus_fee
 159                   + exporter_surplus_fee
 160                   + dsi_revenue_fee;
 161   
 162  change_cs = consumer_surplus_fee - consumer_surplus_base;
 163  change_ps = exporter_surplus_fee - exporter_surplus_base;
 164  change_ts = total_surplus_fee - total_surplus_base;
 165   
 166  deadweight_loss = total_surplus_base - total_surplus_fee;
 167   
 168  * Phase 1: fee incidence (undefined at zero fee)
 169  buyer_incidence = NA;
 170  exporter_incidence = NA;
 171   
 172  if(fee > 0,
 173     buyer_incidence = 100*(price_fee - price_base)/fee;
 174     exporter_incidence = 100*(price_base - net_price_fee)/fee;
 175  );
 176   
 177  * Check if P - fee = MC (interior solution)
 178  check_eq = net_price_fee - (c + d*exports_fee);
 179   
 180  display exports_fee, price_fee, net_price_fee,
 181          exporter_surplus_fee, dsi_revenue_fee, check_eq,
 182          consumer_surplus_fee, total_surplus_fee,
 183          change_cs, change_ps, change_ts, deadweight_loss,
 184          buyer_incidence, exporter_incidence;
 185   
 186  * Phase 1: preserve the main comparison before subsequent loops
 187  parameter main_results(*,*) "baseline and main policy scenario";
 188   
 189  main_results("no_fee","fee_USD_t") = 0;
 190  main_results("no_fee","exports_Mt") = exports_base;
 191  main_results("no_fee","buyer_price_USD_t") = price_base;
 192  main_results("no_fee","net_price_USD_t") = price_base;
 193  main_results("no_fee","consumer_surplus_USDm") = consumer_surplus_base;
 194  main_results("no_fee","exporter_surplus_USDm") = exporter_surplus_base;
 195  main_results("no_fee","dsi_revenue_USDm") = 0;
 196  main_results("no_fee","total_surplus_USDm") = total_surplus_base;
 197  main_results("no_fee","DWL_USDm") = 0;
 198  main_results("no_fee","buyer_incidence_pct") = NA;
 199  main_results("no_fee","exporter_incidence_pct") = NA;
 200   
 201  main_results("with_fee","fee_USD_t") = fee;
 202  main_results("with_fee","exports_Mt") = exports_fee;
 203  main_results("with_fee","buyer_price_USD_t") = price_fee;
 204  main_results("with_fee","net_price_USD_t") = net_price_fee;
 205  main_results("with_fee","consumer_surplus_USDm") = consumer_surplus_fee;
 206  main_results("with_fee","exporter_surplus_USDm") = exporter_surplus_fee;
 207  main_results("with_fee","dsi_revenue_USDm") = dsi_revenue_fee;
 208  main_results("with_fee","total_surplus_USDm") = total_surplus_fee;
 209  main_results("with_fee","DWL_USDm") = deadweight_loss;
 210  main_results("with_fee","buyer_incidence_pct") = buyer_incidence;
 211  main_results("with_fee","exporter_incidence_pct") = exporter_incidence;
 212   
 213  display main_results;
 214   
 215  * Phase 1: verify the main policy scenario against analytical solutions.
 216  * Checks should be close to zero. Triangle DWL is valid for this linear,
 217  * interior equilibrium. No rounding is applied to stored results.
 218  scalar
 219     exports_analytical
 220     dwl_analytical
 221     check_base_quantity
 222     check_base_price
 223     check_base_eq
 224     check_quantity
 225     check_welfare
 226     check_dwl
 227     check_incidence;
 228   
 229  exports_analytical = (a - c - fee)/(d - b);
 230  dwl_analytical = 0.5*fee*(exports_base - exports_fee);
 231   
 232  check_base_quantity = exports_base - xbar;
 233  check_base_price = price_base - pbar;
 234  check_base_eq = price_base - (c + d*exports_base);
 235  check_quantity = exports_fee - exports_analytical;
 236  check_welfare = change_cs + change_ps + dsi_revenue_fee - change_ts;
 237  check_dwl = deadweight_loss - dwl_analytical;
 238  check_incidence = buyer_incidence + exporter_incidence - 100;
 239   
 240  display exports_analytical, dwl_analytical,
 241          check_base_quantity, check_base_price, check_base_eq,
 242          check_quantity, check_eq, check_welfare, check_dwl,
 243          check_incidence;
 244   
 245  * ----------------------------------------
 246  ** 5. Fee Sensitivity Analysis
 247  * ----------------------------------------
 248   
 249  * Test different DSI fees using the same demand and supply curves
 250   
 251  set s "fee scenarios" /f0, f0p5, f1, f3, f5, f7, f9/;
 252   
 253  parameter fee_value(s) "DSI fee [USD/ton]"
 254     /f0   0
 255      f0p5 0.5
 256      f1   1
 257      f3   3
 258      f5   5
 259      f7   7
 260      f9   9/;
 261   
 262  parameter fee_results(s,*) "results for each fee scenario";
 263   
 264  loop(s,
 265   
 266     fee = fee_value(s);
 267     X.l = xbar;
 268   
 269     solve with_dsi_fee using qcp maximizing equilibrium_potential;
 270   
 271     abort$(with_dsi_fee.solvestat ne 1 or
 272           (with_dsi_fee.modelstat ne 1 and with_dsi_fee.modelstat ne 2))
 273        "Fee sensitivity solve did not terminate at an optimum", s;
 274   
 275     price_fee = a + b*X.l;
 276     net_price_fee = price_fee - fee;
 277   
 278     exporter_surplus_fee = net_price_fee*X.l
 279                          - (c*X.l + 0.5*d*sqr(X.l));
 280   
 281     dsi_revenue_fee = fee*X.l;
 282   
 283  *  Phase 1: calculate welfare for each fee scenario
 284     consumer_surplus_fee = -0.5*b*sqr(X.l);
 285     total_surplus_fee = consumer_surplus_fee
 286                       + exporter_surplus_fee + dsi_revenue_fee;
 287   
 288     change_cs = consumer_surplus_fee - consumer_surplus_base;
 289     change_ps = exporter_surplus_fee - exporter_surplus_base;
 290     change_ts = total_surplus_fee - total_surplus_base;
 291     deadweight_loss = total_surplus_base - total_surplus_fee;
 292   
 293     fee_results(s,"fee") = fee;
 294     fee_results(s,"exports_Mt") = X.l;
 295     fee_results(s,"price_USD_t") = price_fee;
 296     fee_results(s,"net_price_USD_t") = net_price_fee;
 297     fee_results(s,"exporter_surplus_USDm") = exporter_surplus_fee;
 298     fee_results(s,"dsi_revenue_USDm") = dsi_revenue_fee;
 299     fee_results(s,"consumer_surplus_USDm") = consumer_surplus_fee;
 300     fee_results(s,"total_surplus_USDm") = total_surplus_fee;
 301     fee_results(s,"DWL_USDm") = deadweight_loss;
 302   
 303  *  Changes relative to the no-fee baseline
 304     fee_results(s,"export_change_pct") = 100*(X.l/exports_base - 1);
 305     fee_results(s,"buyer_price_change") = price_fee - price_base;
 306     fee_results(s,"exporter_net_price_change") = net_price_fee - price_base;
 307     fee_results(s,"change_CS_USDm") = change_cs;
 308     fee_results(s,"change_PS_USDm") = change_ps;
 309     fee_results(s,"change_TS_USDm") = change_ts;
 310   
 311  *  Fee incidence is not defined when fee = 0
 312     fee_results(s,"buyer_incidence_pct") = NA;
 313     fee_results(s,"exporter_incidence_pct") = NA;
 314   
 315     if(fee > 0,
 316        fee_results(s,"buyer_incidence_pct") =
 317           100*(price_fee - price_base)/fee;
 318        fee_results(s,"exporter_incidence_pct") =
 319           100*(price_base - net_price_fee)/fee;
 320     );
 321   
 322  );
 323   
 324  display fee_results;
 325   
 326  * ----------------------------------------
 327  ** 6. Demand Elasticity Sensitivity Analysis
 328  * ----------------------------------------
 329   
 330  * Keep DSI fee at USD 5/ton
 331  * Test different foreign demand elasticities
 332  * Each elasticity must have its own no-fee welfare benchmark.
 333   
 334  fee = 5;
 335   
 336  set t "elasticity scenarios" /e1, e2, e4/;
 337   
 338  parameter elastic_value(t) "residual demand elasticity"
 339     /e1 -1
 340      e2 -2
 341      e4 -4/;
 342   
 343  parameter elastic_results(t,*) "elasticity sensitivity results";
 344  parameter elastic_baseline(t,*) "no-fee welfare benchmark for each elasticity";
 345   
 346  scalar
 347     exports_base_elastic
 348     price_base_elastic
 349     consumer_surplus_base_elastic
 350     exporter_surplus_base_elastic
 351     total_surplus_base_elastic;
 352   
 353  loop(t,
 354   
 355     e_r = elastic_value(t);
 356   
 357  *  Recalibrate demand for each elasticity
 358     b = pbar / (e_r * xbar);
 359     a = pbar - b*xbar;
 360   
 361  *  Phase 1: analytical no-fee benchmark for this elasticity.
 362  *  All current curves are calibrated to the same xbar and pbar.
 363  *  The closed-form interior solution avoids an extra solve here.
 364     exports_base_elastic = (a - c)/(d - b);
 365     price_base_elastic = a + b*exports_base_elastic;
 366   
 367     consumer_surplus_base_elastic = -0.5*b*sqr(exports_base_elastic);
 368     exporter_surplus_base_elastic = price_base_elastic*exports_base_elastic
 369                    - (c*exports_base_elastic + 0.5*d*sqr(exports_base_elastic));
 370     total_surplus_base_elastic = consumer_surplus_base_elastic
 371                                + exporter_surplus_base_elastic;
 372   
 373     elastic_baseline(t,"elasticity") = e_r;
 374     elastic_baseline(t,"exports_Mt") = exports_base_elastic;
 375     elastic_baseline(t,"price_USD_t") = price_base_elastic;
 376     elastic_baseline(t,"consumer_surplus_USDm") = consumer_surplus_base_elastic;
 377     elastic_baseline(t,"exporter_surplus_USDm") = exporter_surplus_base_elastic;
 378     elastic_baseline(t,"total_surplus_USDm") = total_surplus_base_elastic;
 379   
 380     X.l = xbar;
 381   
 382     solve with_dsi_fee using qcp maximizing equilibrium_potential;
 383   
 384     abort$(with_dsi_fee.solvestat ne 1 or
 385           (with_dsi_fee.modelstat ne 1 and with_dsi_fee.modelstat ne 2))
 386        "Elasticity sensitivity solve did not terminate at an optimum", t;
 387   
 388     price_fee = a + b*X.l;
 389     net_price_fee = price_fee - fee;
 390   
 391     exporter_surplus_fee = net_price_fee*X.l
 392                          - (c*X.l + 0.5*d*sqr(X.l));
 393   
 394     dsi_revenue_fee = fee*X.l;
 395   
 396  *  Phase 1: welfare relative to the matching no-fee benchmark
 397     consumer_surplus_fee = -0.5*b*sqr(X.l);
 398     total_surplus_fee = consumer_surplus_fee
 399                       + exporter_surplus_fee + dsi_revenue_fee;
 400   
 401     change_cs = consumer_surplus_fee - consumer_surplus_base_elastic;
 402     change_ps = exporter_surplus_fee - exporter_surplus_base_elastic;
 403     change_ts = total_surplus_fee - total_surplus_base_elastic;
 404     deadweight_loss = total_surplus_base_elastic - total_surplus_fee;
 405   
 406     elastic_results(t,"elasticity") = e_r;
 407     elastic_results(t,"exports_Mt") = X.l;
 408     elastic_results(t,"buyer_price_USD_t") = price_fee;
 409     elastic_results(t,"net_exporter_USD_t") = net_price_fee;
 410     elastic_results(t,"exporter_surplus_USDm") = exporter_surplus_fee;
 411     elastic_results(t,"dsi_revenue_USDm") = dsi_revenue_fee;
 412     elastic_results(t,"consumer_surplus_USDm") = consumer_surplus_fee;
 413     elastic_results(t,"total_surplus_USDm") = total_surplus_fee;
 414     elastic_results(t,"DWL_USDm") = deadweight_loss;
 415     elastic_results(t,"export_change_pct") = 100*(X.l/exports_base_elastic - 1);
 416     elastic_results(t,"buyer_price_change") = price_fee - price_base_elastic;
 417     elastic_results(t,"exporter_net_price_change") = net_price_fee - price_base_elastic;
 418     elastic_results(t,"change_CS_USDm") = change_cs;
 419     elastic_results(t,"change_PS_USDm") = change_ps;
 420     elastic_results(t,"change_TS_USDm") = change_ts;
 421   
 422     elastic_results(t,"buyer_incidence_pct") = NA;
 423     elastic_results(t,"exporter_incidence_pct") = NA;
 424   
 425     if(fee > 0,
 426        elastic_results(t,"buyer_incidence_pct") =
 427           100*(price_fee - price_base_elastic)/fee;
 428        elastic_results(t,"exporter_incidence_pct") =
 429           100*(price_base_elastic - net_price_fee)/fee;
 430     );
 431   
 432  );
 433   
 434  display elastic_baseline, elastic_results;
 435   
 436  * Restore the main elasticity assumption.
 437  * The last X.l is still the last elasticity scenario, not the main case.
 438  * Use main_results or fee_results("f5",...) for the main case.
 439  e_r = -2;
 440  b = pbar / (e_r * xbar);
 441  a = pbar - b*xbar;
 442   
 443  * ----------------------------------------
 444  ** 7. DSI Operating Margin Sensitivity
 445  * ----------------------------------------
 446   
 447  * Assume DSI operating margins of 25%, 50%, and 75%
 448  * Use the DSI revenue from the USD 5/ton fee scenario
 449  * Retained from M3; cost-adjusted welfare and break-even are Phase 2.
 450   
 451  set m "DSI margin scenarios" /m25, m50, m75/;
 452   
 453  parameter margin_value(m) "DSI operating margin"
 454     /m25 0.25
 455      m50 0.50
 456      m75 0.75/;
 457   
 458  parameter margin_results(m,*) "DSI operating cost and profit";
 459   
 460  scalar revenue_f5 "DSI revenue at USD 5/ton";
 461   
 462  revenue_f5 = fee_results("f5","dsi_revenue_USDm");
 463   
 464  loop(m,
 465   
 466     margin_results(m,"margin_pct") = 100*margin_value(m);
 467     margin_results(m,"revenue_USDm") = revenue_f5;
 468     margin_results(m,"operating_cost_USDm") =
 469         revenue_f5*(1 - margin_value(m));
 470     margin_results(m,"operating_profit_USDm") =
 471         revenue_f5*margin_value(m);
 472   
 473  );
 474   
 475  display margin_results;
 476   
