GAMS 54.3.1  61154be4 Aug 21, 2026          DAX-DAC arm 64bit/macOS - 11/24/26 12:58:22 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  ** Final Project - DSI export fee on Indonesian Ferronickel
   2  ** Final version - market, economic feasibility, sovereign wealth, reporting
   3  ** Retains the verified Phase 1 equilibrium and welfare formulation
   4  ** Market assumption: 1 commodity, 1 period, competitive exporters
   5  ** Using 2025 export data; elasticities and fees are assumed
   6  ** X = exports (million metric tons); P = USD per ton of product
   7  ** Revenue, cost, surplus, and profit are in million USD
   8  ** CS refers to surplus under foreign residual demand.
   9  ** Gross total surplus excludes real DSI operating costs and governance benefits.
  10  ** Operating margins are illustrative assumptions, not actual DSI margins.
  11   
  12  option decimals = 6;
  13   
  14  * ----------------------------------------
  15  ** 1. Input Values and Elasticities
  16  * ----------------------------------------
  17   
  18  scalar
  19     vbar "2025 export value [million USD]" /16385.06673/
  20     xbar "2025 export quantity [million tons]" /11.5556/
  21     pbar "average export price [USD/ton]"
  22     e_r  "residual demand elasticity [unitless]" /-2/
  23     e_s  "supply elasticity [unitless]" /1/;
  24   
  25  * Average price from 2025 export data
  26  pbar = vbar / xbar;
  27   
  28  display vbar, xbar, pbar, e_r, e_s;
  29   
  30  * ----------------------------------------
  31  ** 2. Determine Inverse Residual Demand and Marginal Cost
  32  * ----------------------------------------
  33   
  34  * P(X) = a + bX
  35  * MC(X) = c + dX
  36   
  37  scalar
  38     a "demand intercept"
  39     b "demand slope"
  40     c "marginal cost intercept"
  41     d "marginal cost slope";
  42   
  43  * Calibrate using price, quantity, and elasticities
  44  b = pbar / (e_r * xbar);
  45  a = pbar - b * xbar;
  46   
  47  d = pbar / (e_s * xbar);
  48  c = pbar - d * xbar;
  49   
  50  display a, b, c, d;
  51   
  52  * ----------------------------------------
  53  ** 3. Direct Selling - No Fee
  54  * ----------------------------------------
  55   
  56  * Competitive market, where P = MC
  57   
  58  positive variable X "export quantity";
  59  variable equilibrium_potential "equilibrium potential, not national welfare";
  60   
  61  equation eq_surplus;
  62   
  63  eq_surplus..
  64     equilibrium_potential =e=
  65       a*X + 0.5*b*sqr(X)
  66     - c*X - 0.5*d*sqr(X);
  67   
  68  model direct_selling /eq_surplus/;
  69   
  70  X.l = xbar;
  71   
  72  solve direct_selling using qcp maximizing equilibrium_potential;
  73   
  74  abort$(direct_selling.solvestat ne 1 or
  75        (direct_selling.modelstat ne 1 and direct_selling.modelstat ne 2))
  76     "No-fee solve did not terminate at an optimum";
  77   
  78  * Calculate baseline price, exporter surplus, and welfare
  79  scalar
  80     exports_base "baseline export quantity [Mt]"
  81     price_base "baseline buyer and exporter price [USD/ton]"
  82     exporter_surplus_base "baseline producer surplus [million USD]"
  83     consumer_surplus_base "baseline residual buyer surplus [million USD]"
  84     total_surplus_base "baseline modeled market surplus [million USD]";
  85   
  86  exports_base = X.l;
  87  price_base = a + b*exports_base;
  88   
  89  exporter_surplus_base = price_base*exports_base
  90                        - (c*exports_base + 0.5*d*sqr(exports_base));
  91   
  92  * Phase 1: consumer surplus and total surplus
  93  consumer_surplus_base = -0.5*b*sqr(exports_base);
  94   
  95  total_surplus_base = consumer_surplus_base + exporter_surplus_base;
  96   
  97  display exports_base, price_base, exporter_surplus_base,
  98          consumer_surplus_base, total_surplus_base;
  99   
 100  * ----------------------------------------
 101  ** 4. Direct Selling - With DSI Fee
 102  * ----------------------------------------
 103   
 104  * Exporters pay a hypothetical fee to DSI for monitoring and verification.
 105  * DSI revenue is not the same as DSI profit.
 106  * The fee is deducted in the equilibrium potential to obtain P - fee = MC.
 107  * It is added back in total surplus because it is a transfer before costs.
 108   
 109  scalar fee "DSI fee [USD/ton]" /5/;
 110   
 111  equation eq_fee;
 112   
 113  eq_fee..
 114     equilibrium_potential =e=
 115       a*X + 0.5*b*sqr(X)
 116     - c*X - 0.5*d*sqr(X)
 117     - fee*X;
 118   
 119  model with_dsi_fee /eq_fee/;
 120   
 121  X.l = xbar;
 122   
 123  solve with_dsi_fee using qcp maximizing equilibrium_potential;
 124   
 125  abort$(with_dsi_fee.solvestat ne 1 or
 126        (with_dsi_fee.modelstat ne 1 and with_dsi_fee.modelstat ne 2))
 127     "Main fee solve did not terminate at an optimum";
 128   
 129  scalar
 130     exports_fee "export quantity with fee [Mt]"
 131     price_fee "foreign buyer price [USD/ton]"
 132     net_price_fee "net exporter price [USD/ton]"
 133     exporter_surplus_fee "producer surplus [million USD]"
 134     dsi_revenue_fee "DSI gross revenue [million USD]"
 135     consumer_surplus_fee "residual buyer surplus [million USD]"
 136     total_surplus_fee "modeled market surplus before DSI costs [million USD]"
 137     change_cs "change in consumer surplus [million USD]"
 138     change_ps "change in producer surplus [million USD]"
 139     change_ts "change in total surplus [million USD]"
 140     deadweight_loss "loss in total surplus before DSI costs [million USD]"
 141     buyer_incidence "buyer share of per-ton fee [percent]"
 142     exporter_incidence "exporter share of per-ton fee [percent]"
 143     check_eq "fee-adjusted equilibrium residual [USD/ton]";
 144   
 145  exports_fee = X.l;
 146  price_fee = a + b*exports_fee;
 147  net_price_fee = price_fee - fee;
 148   
 149  exporter_surplus_fee = net_price_fee*exports_fee
 150                      - (c*exports_fee + 0.5*d*sqr(exports_fee));
 151   
 152  dsi_revenue_fee = fee*exports_fee;
 153   
 154  * Phase 1: welfare with DSI fee
 155  consumer_surplus_fee = -0.5*b*sqr(exports_fee);
 156   
 157  total_surplus_fee = consumer_surplus_fee
 158                   + exporter_surplus_fee
 159                   + dsi_revenue_fee;
 160   
 161  change_cs = consumer_surplus_fee - consumer_surplus_base;
 162  change_ps = exporter_surplus_fee - exporter_surplus_base;
 163  change_ts = total_surplus_fee - total_surplus_base;
 164   
 165  deadweight_loss = total_surplus_base - total_surplus_fee;
 166   
 167  * Phase 1: fee incidence (undefined at zero fee)
 168  buyer_incidence = NA;
 169  exporter_incidence = NA;
 170   
 171  if(fee > 0,
 172     buyer_incidence = 100*(price_fee - price_base)/fee;
 173     exporter_incidence = 100*(price_base - net_price_fee)/fee;
 174  );
 175   
 176  * Check if P - fee = MC (interior solution)
 177  check_eq = net_price_fee - (c + d*exports_fee);
 178   
 179  display exports_fee, price_fee, net_price_fee,
 180          exporter_surplus_fee, dsi_revenue_fee, check_eq,
 181          consumer_surplus_fee, total_surplus_fee,
 182          change_cs, change_ps, change_ts, deadweight_loss,
 183          buyer_incidence, exporter_incidence;
 184   
 185  * Phase 1: preserve the main comparison before subsequent loops
 186  parameter main_results(*,*) "baseline and main policy scenario";
 187   
 188  main_results("no_fee","fee_USD_t") = 0;
 189  main_results("no_fee","exports_Mt") = exports_base;
 190  main_results("no_fee","buyer_price_USD_t") = price_base;
 191  main_results("no_fee","net_price_USD_t") = price_base;
 192  main_results("no_fee","consumer_surplus_USDm") = consumer_surplus_base;
 193  main_results("no_fee","exporter_surplus_USDm") = exporter_surplus_base;
 194  main_results("no_fee","dsi_revenue_USDm") = 0;
 195  main_results("no_fee","total_surplus_USDm") = total_surplus_base;
 196  main_results("no_fee","DWL_USDm") = 0;
 197  main_results("no_fee","buyer_incidence_pct") = NA;
 198  main_results("no_fee","exporter_incidence_pct") = NA;
 199   
 200  main_results("with_fee","fee_USD_t") = fee;
 201  main_results("with_fee","exports_Mt") = exports_fee;
 202  main_results("with_fee","buyer_price_USD_t") = price_fee;
 203  main_results("with_fee","net_price_USD_t") = net_price_fee;
 204  main_results("with_fee","consumer_surplus_USDm") = consumer_surplus_fee;
 205  main_results("with_fee","exporter_surplus_USDm") = exporter_surplus_fee;
 206  main_results("with_fee","dsi_revenue_USDm") = dsi_revenue_fee;
 207  main_results("with_fee","total_surplus_USDm") = total_surplus_fee;
 208  main_results("with_fee","DWL_USDm") = deadweight_loss;
 209  main_results("with_fee","buyer_incidence_pct") = buyer_incidence;
 210  main_results("with_fee","exporter_incidence_pct") = exporter_incidence;
 211   
 212  display main_results;
 213   
 214  * Phase 1: verify the main policy scenario against analytical solutions.
 215  * Checks should be close to zero. Triangle DWL is valid for this linear,
 216  * interior equilibrium. No rounding is applied to stored results.
 217  scalar
 218     exports_analytical
 219     dwl_analytical
 220     check_base_quantity
 221     check_base_price
 222     check_base_eq
 223     check_quantity
 224     check_welfare
 225     check_dwl
 226     check_incidence;
 227   
 228  exports_analytical = (a - c - fee)/(d - b);
 229  dwl_analytical = 0.5*fee*(exports_base - exports_fee);
 230   
 231  check_base_quantity = exports_base - xbar;
 232  check_base_price = price_base - pbar;
 233  check_base_eq = price_base - (c + d*exports_base);
 234  check_quantity = exports_fee - exports_analytical;
 235  check_welfare = change_cs + change_ps + dsi_revenue_fee - change_ts;
 236  check_dwl = deadweight_loss - dwl_analytical;
 237  check_incidence = buyer_incidence + exporter_incidence - 100;
 238   
 239  display exports_analytical, dwl_analytical,
 240          check_base_quantity, check_base_price, check_base_eq,
 241          check_quantity, check_eq, check_welfare, check_dwl,
 242          check_incidence;
 243   
 244  * ----------------------------------------
 245  ** 5. Full Fee and Demand Elasticity Scenario Matrix
 246  * ----------------------------------------
 247   
 248  * Solve all seven fee levels for each of three demand elasticities.
 249  * Each elasticity has its own no-fee welfare benchmark.
 250  * The supply elasticity remains unchanged.
 251   
 252  set s "fee scenarios" /f0, f0p5, f1, f3, f5, f7, f9/;
 253  set t "elasticity scenarios" /e1, e2, e4/;
 254  set positive_fee(s) "positive fee scenarios";
 255   
 256  parameter fee_value(s) "DSI fee [USD/ton]"
 257     /f0 0, f0p5 0.5, f1 1, f3 3, f5 5, f7 7, f9 9/;
 258   
 259  parameter elastic_value(t) "residual demand elasticity"
 260     /e1 -1, e2 -2, e4 -4/;
 261   
 262  positive_fee(s) = yes$(fee_value(s) > 0);
 263   
 264  set metric "market and welfare results"
 265     /fee_USD_t, elasticity, exports_Mt, buyer_price_USD_t,
 266      net_price_USD_t, consumer_surplus_USDm, exporter_surplus_USDm,
 267      dsi_revenue_USDm, total_surplus_USDm, DWL_USDm,
 268      export_change_pct, buyer_price_change, exporter_net_price_change,
 269      change_CS_USDm, change_PS_USDm, change_TS_USDm,
 270      buyer_incidence_pct, exporter_incidence_pct/;
 271   
 272  parameter
 273     scenario_results(t,s,metric) "all 21 market equilibrium combinations"
 274     elastic_baseline(t,*) "analytical no-fee benchmark by elasticity"
 275     scenario_checks(t,s,*) "basic numerical consistency checks";
 276   
 277  scalar
 278     exports_base_elastic
 279     price_base_elastic
 280     consumer_surplus_base_elastic
 281     exporter_surplus_base_elastic
 282     total_surplus_base_elastic
 283     tol_quantity /0.000001/
 284     tol_money /0.0001/
 285     tol_price /0.0001/
 286     tol_pct /0.001/;
 287   
 288  loop(t,
 289   
 290     e_r = elastic_value(t);
 291   
 292  *  Recalibrate inverse residual demand to the same observed benchmark.
 293     b = pbar / (e_r*xbar);
 294     a = pbar - b*xbar;
 295   
 296  *  Analytical no-fee benchmark for this elasticity.
 297  *  The numerical no-fee case is also solved in the inner loop.
 298     exports_base_elastic = (a - c)/(d - b);
 299     price_base_elastic = a + b*exports_base_elastic;
 300     consumer_surplus_base_elastic = -0.5*b*sqr(exports_base_elastic);
 301     exporter_surplus_base_elastic = price_base_elastic*exports_base_elastic
 302                    - (c*exports_base_elastic + 0.5*d*sqr(exports_base_elastic));
 303     total_surplus_base_elastic = consumer_surplus_base_elastic
 304                               + exporter_surplus_base_elastic;
 305   
 306     elastic_baseline(t,"elasticity") = e_r;
 307     elastic_baseline(t,"exports_Mt") = exports_base_elastic;
 308     elastic_baseline(t,"price_USD_t") = price_base_elastic;
 309     elastic_baseline(t,"consumer_surplus_USDm") = consumer_surplus_base_elastic;
 310     elastic_baseline(t,"exporter_surplus_USDm") = exporter_surplus_base_elastic;
 311     elastic_baseline(t,"total_surplus_USDm") = total_surplus_base_elastic;
 312   
 313     loop(s,
 314   
 315        fee = fee_value(s);
 316        X.l = xbar;
 317   
 318        solve with_dsi_fee using qcp maximizing equilibrium_potential;
 319   
 320        abort$(with_dsi_fee.solvestat ne 1 or
 321              (with_dsi_fee.modelstat ne 1 and with_dsi_fee.modelstat ne 2))
 322           "Scenario solve did not terminate at an optimum", t, s;
 323   
 324  *     All fee and elasticity assumptions here imply an interior solution.
 325        abort$(X.l <= 0) "Interior solution required for welfare formulas", t, s;
 326   
 327  *     Market outcomes
 328        price_fee = a + b*X.l;
 329        net_price_fee = price_fee - fee;
 330        exporter_surplus_fee = net_price_fee*X.l
 331                             - (c*X.l + 0.5*d*sqr(X.l));
 332        dsi_revenue_fee = fee*X.l;
 333   
 334  *     Welfare before DSI operating costs
 335        consumer_surplus_fee = -0.5*b*sqr(X.l);
 336        total_surplus_fee = consumer_surplus_fee
 337                          + exporter_surplus_fee + dsi_revenue_fee;
 338   
 339        change_cs = consumer_surplus_fee - consumer_surplus_base_elastic;
 340        change_ps = exporter_surplus_fee - exporter_surplus_base_elastic;
 341        change_ts = total_surplus_fee - total_surplus_base_elastic;
 342        deadweight_loss = -change_ts;
 343   
 344        scenario_results(t,s,"fee_USD_t") = fee;
 345        scenario_results(t,s,"elasticity") = e_r;
 346        scenario_results(t,s,"exports_Mt") = X.l;
 347        scenario_results(t,s,"buyer_price_USD_t") = price_fee;
 348        scenario_results(t,s,"net_price_USD_t") = net_price_fee;
 349        scenario_results(t,s,"consumer_surplus_USDm") = consumer_surplus_fee;
 350        scenario_results(t,s,"exporter_surplus_USDm") = exporter_surplus_fee;
 351        scenario_results(t,s,"dsi_revenue_USDm") = dsi_revenue_fee;
 352        scenario_results(t,s,"total_surplus_USDm") = total_surplus_fee;
 353        scenario_results(t,s,"DWL_USDm") = deadweight_loss;
 354        scenario_results(t,s,"export_change_pct") = 100*(X.l/exports_base_elastic - 1);
 355        scenario_results(t,s,"buyer_price_change") = price_fee - price_base_elastic;
 356        scenario_results(t,s,"exporter_net_price_change") = net_price_fee - price_base_elastic;
 357        scenario_results(t,s,"change_CS_USDm") = change_cs;
 358        scenario_results(t,s,"change_PS_USDm") = change_ps;
 359        scenario_results(t,s,"change_TS_USDm") = change_ts;
 360   
 361  *     Fee incidence is undefined when fee = 0.
 362        scenario_results(t,s,"buyer_incidence_pct") = NA;
 363        scenario_results(t,s,"exporter_incidence_pct") = NA;
 364   
 365        if(fee > 0,
 366           scenario_results(t,s,"buyer_incidence_pct") =
 367              100*(price_fee - price_base_elastic)/fee;
 368           scenario_results(t,s,"exporter_incidence_pct") =
 369              100*(price_base_elastic - net_price_fee)/fee;
 370        );
 371   
 372  *     Basic checks for every equilibrium in the matrix.
 373        scenario_checks(t,s,"solver_status") = with_dsi_fee.solvestat;
 374        scenario_checks(t,s,"model_status") = with_dsi_fee.modelstat;
 375        scenario_checks(t,s,"quantity_residual") = X.l - (a-c-fee)/(d-b);
 376        scenario_checks(t,s,"equilibrium_residual") = net_price_fee - (c+d*X.l);
 377        scenario_checks(t,s,"welfare_residual") = change_cs + change_ps
 378                                               + dsi_revenue_fee - change_ts;
 379        scenario_checks(t,s,"DWL_residual") = deadweight_loss
 380                                           - 0.5*fee*(exports_base_elastic-X.l);
 381        scenario_checks(t,s,"incidence_residual") = NA;
 382   
 383        if(fee > 0,
 384           scenario_checks(t,s,"incidence_residual") =
 385                scenario_results(t,s,"buyer_incidence_pct")
 386              + scenario_results(t,s,"exporter_incidence_pct") - 100;
 387           abort$(abs(scenario_checks(t,s,"incidence_residual")) > tol_pct)
 388              "Fee incidence check failed", t, s;
 389        );
 390   
 391        abort$(abs(scenario_checks(t,s,"quantity_residual")) > tol_quantity or
 392               abs(scenario_checks(t,s,"equilibrium_residual")) > tol_price or
 393               abs(scenario_checks(t,s,"welfare_residual")) > tol_money or
 394               abs(scenario_checks(t,s,"DWL_residual")) > tol_money or
 395               deadweight_loss < -tol_money)
 396           "Scenario consistency check failed", t, s;
 397   
 398        if(fee = 0,
 399           abort$(abs(X.l-xbar) > tol_quantity or abs(price_fee-pbar) > tol_price)
 400              "No-fee calibration check failed", t;
 401        );
 402   
 403     );
 404  );
 405   
 406  * Restore benchmark inputs. X.l and other mutable result scalars
 407  * still belong to the last solve; use stored parameters below.
 408  e_r = elastic_value("e2");
 409  b = pbar/(e_r*xbar);
 410  a = pbar - b*xbar;
 411  fee = fee_value("f5");
 412   
 413  * Check the replicated main case against Sections 3 and 4.
 414  abort$(abs(scenario_results("e2","f5","exports_Mt")
 415          - main_results("with_fee","exports_Mt")) > tol_quantity or
 416         abs(scenario_results("e2","f5","DWL_USDm")
 417          - main_results("with_fee","DWL_USDm")) > tol_money)
 418     "Main case replication failed";
 419   
 420  display elastic_baseline, scenario_results, scenario_checks;
 421   
 422  * ----------------------------------------
 423  ** 6. Fee and Demand Elasticity Sensitivity Results
 424  * ----------------------------------------
 425   
 426  * Extract the same two sensitivity tables as in Phase 1.
 427  * Both tables use the common field names from scenario_results.
 428  * No additional optimization is required.
 429   
 430  parameter
 431     fee_results(s,metric) "fee sensitivity at elasticity -2"
 432     elastic_results(t,metric) "elasticity sensitivity at USD 5/ton"
 433     export_change_matrix(s,t) "export change [percent]"
 434     ps_loss_matrix(s,t) "producer surplus loss [million USD]"
 435     dwl_matrix(s,t) "deadweight loss [thousand USD]";
 436   
 437  fee_results(s,metric) = scenario_results("e2",s,metric);
 438  elastic_results(t,metric) = scenario_results(t,"f5",metric);
 439   
 440  export_change_matrix(s,t) = scenario_results(t,s,"export_change_pct");
 441  ps_loss_matrix(s,t) = -scenario_results(t,s,"change_PS_USDm");
 442  dwl_matrix(s,t) = 1000*scenario_results(t,s,"DWL_USDm");
 443   
 444  display fee_results, elastic_results,
 445          export_change_matrix, ps_loss_matrix, dwl_matrix;
 446   
 447  * ----------------------------------------
 448  ** 7. DSI Operating Margin Sensitivity
 449  * ----------------------------------------
 450   
 451  * Operating margins of 25%, 50%, and 75% are assumed, not estimated.
 452  * Operating cost = (1-margin)*gross revenue.
 453  * Operating profit = margin*gross revenue.
 454  * Costs are assumed incremental real resource costs for net welfare.
 455  * Assume full domestic attribution of producer surplus and DSI profit.
 456  * Conditional domestic surplus is not Indonesian national welfare.
 457  * Governance benefits, corporate taxes, capex and financing are excluded.
 458  * The no-DSI / zero-fee benchmark has no incremental DSI costs.
 459  * Only the 18 positive-fee scenarios receive margin sensitivity analysis.
 460   
 461  set m "DSI margin scenarios" /m25, m50, m75/;
 462  parameter margin_value(m) "assumed DSI operating margin"
 463     /m25 0.25, m50 0.50, m75 0.75/;
 464   
 465  set fin_metric "financial and net welfare results"
 466     /margin_pct, revenue_USDm, operating_cost_USDm, operating_profit_USDm,
 467      change_PS_USDm, DWL_USDm, domestic_surplus_change_USDm,
 468      net_total_surplus_USDm, net_total_surplus_change_USDm,
 469      required_governance_benefit_USDm/;
 470   
 471  parameter
 472     margin_matrix(t,s,m,fin_metric) "54 positive fee and operating margin cases"
 473     margin_results(m,fin_metric) "main case operating margin sensitivity"
 474     domestic_matrix(t,s,m) "conditional domestic surplus change [million USD]";
 475   
 476  scalar
 477     revenue_case
 478     cost_case
 479     profit_case
 480     ps_change_case
 481     dwl_case
 482     domestic_change_case
 483     net_ts_change_case;
 484   
 485  loop((t,s,m)$positive_fee(s),
 486   
 487     revenue_case = scenario_results(t,s,"dsi_revenue_USDm");
 488     ps_change_case = scenario_results(t,s,"change_PS_USDm");
 489     dwl_case = scenario_results(t,s,"DWL_USDm");
 490   
 491     cost_case = (1-margin_value(m))*revenue_case;
 492     profit_case = margin_value(m)*revenue_case;
 493   
 494  *  Conditional domestic surplus: producer surplus change plus DSI profit.
 495     domestic_change_case = ps_change_case + profit_case;
 496   
 497  *  Total modeled market surplus including foreign buyers, after costs.
 498     net_ts_change_case = -dwl_case - cost_case;
 499   
 500     margin_matrix(t,s,m,"margin_pct") = 100*margin_value(m);
 501     margin_matrix(t,s,m,"revenue_USDm") = revenue_case;
 502     margin_matrix(t,s,m,"operating_cost_USDm") = cost_case;
 503     margin_matrix(t,s,m,"operating_profit_USDm") = profit_case;
 504     margin_matrix(t,s,m,"change_PS_USDm") = ps_change_case;
 505     margin_matrix(t,s,m,"DWL_USDm") = dwl_case;
 506     margin_matrix(t,s,m,"domestic_surplus_change_USDm") = domestic_change_case;
 507     margin_matrix(t,s,m,"net_total_surplus_USDm") =
 508        scenario_results(t,s,"total_surplus_USDm") - cost_case;
 509     margin_matrix(t,s,m,"net_total_surplus_change_USDm") = net_ts_change_case;
 510   
 511  *  Minimum incremental real governance benefit needed for market welfare
 512  *  break-even; not an estimate of actual governance benefits.
 513     margin_matrix(t,s,m,"required_governance_benefit_USDm") =
 514        max(0,dwl_case + cost_case);
 515   
 516     domestic_matrix(t,s,m) = domestic_change_case;
 517   
 518     abort$(abs(revenue_case-cost_case-profit_case) > tol_money or
 519            abs(net_ts_change_case - (scenario_results(t,s,"change_CS_USDm")
 520                + domestic_change_case)) > tol_money)
 521        "Operating margin accounting check failed", t, s, m;
 522  );
 523   
 524  * Main case: fee = 5, residual demand elasticity = -2.
 525  margin_results(m,fin_metric) = margin_matrix("e2","f5",m,fin_metric);
 526   
 527  display margin_results, margin_matrix, domestic_matrix;
 528   
 529  * ----------------------------------------
 530  ** 8. Conditional Domestic Surplus and Break-even Analysis
 531  * ----------------------------------------
 532   
 533  * Find the minimum operating margin and maximum tolerable operating cost
 534  * such that the loss in producer surplus is offset by DSI operating profit.
 535  * These are domestic surplus thresholds, NOT corporate break-even margins.
 536  * Neither threshold implies total market welfare increases.
 537  * No fee optimization or actual operating cost calibration is performed.
 538   
 539  set be_metric "domestic surplus break-even results"
 540     /fee_USD_t, elasticity, revenue_USDm, PS_loss_USDm,
 541      min_margin_pct, max_opex_USDm, max_opex_pct_revenue,
 542      max_opex_USD_t, domestic_change_at_break_even_USDm/;
 543   
 544  parameter
 545     break_even_results(t,s,be_metric) "positive-fee break-even thresholds"
 546     break_even_main(t,be_metric) "break-even at USD 5/ton"
 547     min_margin_matrix(s,t) "minimum operating margin [percent]"
 548     max_opex_matrix(s,t) "maximum tolerable operating cost [million USD]";
 549   
 550  scalar
 551     ps_loss_case
 552     min_margin_case
 553     max_opex_case
 554     break_even_check;
 555   
 556  * At zero fee, ratio thresholds are undefined; the no-DSI cost limit is zero.
 557  min_margin_matrix("f0",t) = NA;
 558  max_opex_matrix("f0",t) = 0;
 559   
 560  loop((t,s)$positive_fee(s),
 561   
 562     revenue_case = scenario_results(t,s,"dsi_revenue_USDm");
 563     ps_loss_case = -scenario_results(t,s,"change_PS_USDm");
 564   
 565     abort$(revenue_case <= 0) "Positive revenue required for break-even", t, s;
 566   
 567     min_margin_case = ps_loss_case/revenue_case;
 568     max_opex_case = revenue_case - ps_loss_case;
 569     break_even_check = min_margin_case*revenue_case - ps_loss_case;
 570   
 571  *  Do not truncate the threshold: if margin > 100 percent or cost < 0,
 572  *  domestic break-even is not possible with nonnegative operating costs.
 573     break_even_results(t,s,"fee_USD_t") = fee_value(s);
 574     break_even_results(t,s,"elasticity") = elastic_value(t);
 575     break_even_results(t,s,"revenue_USDm") = revenue_case;
 576     break_even_results(t,s,"PS_loss_USDm") = ps_loss_case;
 577     break_even_results(t,s,"min_margin_pct") = 100*min_margin_case;
 578     break_even_results(t,s,"max_opex_USDm") = max_opex_case;
 579     break_even_results(t,s,"max_opex_pct_revenue") = 100*(1-min_margin_case);
 580     break_even_results(t,s,"max_opex_USD_t") =
 581        max_opex_case/scenario_results(t,s,"exports_Mt");
 582     break_even_results(t,s,"domestic_change_at_break_even_USDm") = break_even_check;
 583   
 584     min_margin_matrix(s,t) = 100*min_margin_case;
 585     max_opex_matrix(s,t) = max_opex_case;
 586   
 587     abort$(abs(break_even_check) > tol_money)
 588        "Domestic surplus break-even check failed", t, s;
 589  );
 590   
 591  break_even_main(t,be_metric) = break_even_results(t,"f5",be_metric);
 592   
 593  * Compact output counts for Phase 2.
 594  scalar n_market_cases, n_positive_fee_cases, n_margin_cases;
 595  n_market_cases = card(t)*card(s);
 596  n_positive_fee_cases = card(t)*card(positive_fee);
 597  n_margin_cases = n_positive_fee_cases*card(m);
 598   
 599  display break_even_main, break_even_results,
 600          min_margin_matrix, max_opex_matrix,
 601          n_market_cases, n_positive_fee_cases, n_margin_cases;
 602   
 603  * ----------------------------------------
 604  ** 9. Sovereign Wealth Accumulation
 605  * ----------------------------------------
 606   
 607  * Illustrative financial extension, not additional economic welfare.
 608  * Use the main Phase 2 case: fee = 5 USD/t, demand elasticity = -2.
 609  * Assume 100 percent of operating profit is available for distribution
 610  * to Danantara and invested at the end of each year.
 611  * Annual contribution and nominal USD investment return are constant.
 612  * Initial portfolio = 0; no withdrawals, taxes, capex or financing.
 613  * Discount rate and investment returns are illustrative, not forecasts.
 614  * No additional market equilibrium solves are needed.
 615   
 616  set r "annual investment return scenarios" /r4, r6p3, r8/;
 617  set h "investment horizons" /y5, y10, y20/;
 618   
 619  parameter return_value(r) "assumed annual investment return"
 620     /r4 0.04, r6p3 0.063, r8 0.08/;
 621   
 622  parameter horizon_years(h) "investment horizon [years]"
 623     /y5 5, y10 10, y20 20/;
 624   
 625  scalar swf_discount_rate "assumed annual nominal USD discount rate" /0.08/;
 626  scalar distribution_share "assumed share of operating profit invested" /1/;
 627   
 628  set swf_metric "sovereign wealth simulation results"
 629     /margin_pct, return_pct, years, annual_contribution_USDm,
 630      cumulative_contribution_USDm, investment_gain_USDm,
 631      future_value_USDm, present_value_USDm/;
 632   
 633  parameter
 634     swf_results(m,r,h,swf_metric) "27 sovereign wealth scenarios"
 635     swf_base_return(m,h) "future value at 6.3 percent return [million USD]"
 636     swf_high_margin(r,h) "future value at 75 percent margin [million USD]"
 637     swf_high_margin_pv(r,h) "present value at 75 percent margin [million USD]";
 638   
 639  scalar annual_contribution, cumulative_contribution, future_wealth,
 640         investment_gain, present_wealth, n_swf_cases;
 641   
 642  loop((m,r,h),
 643   
 644  *  Read stored Phase 2 benchmark profits, not the last scenario's scalars.
 645     annual_contribution = distribution_share
 646                         * margin_results(m,"operating_profit_USDm");
 647   
 648     cumulative_contribution = annual_contribution*horizon_years(h);
 649   
 650  *  Ordinary annuity: contributions occur at the end of each year.
 651     future_wealth = annual_contribution
 652                   * ((1+return_value(r))**horizon_years(h)-1)/return_value(r);
 653   
 654     investment_gain = future_wealth - cumulative_contribution;
 655     present_wealth = future_wealth/(1+swf_discount_rate)**horizon_years(h);
 656   
 657     swf_results(m,r,h,"margin_pct") = 100*margin_value(m);
 658     swf_results(m,r,h,"return_pct") = 100*return_value(r);
 659     swf_results(m,r,h,"years") = horizon_years(h);
 660     swf_results(m,r,h,"annual_contribution_USDm") = annual_contribution;
 661     swf_results(m,r,h,"cumulative_contribution_USDm") = cumulative_contribution;
 662     swf_results(m,r,h,"investment_gain_USDm") = investment_gain;
 663     swf_results(m,r,h,"future_value_USDm") = future_wealth;
 664     swf_results(m,r,h,"present_value_USDm") = present_wealth;
 665   
 666  *  Basic consistency check: with positive returns, FV >= contributions.
 667     abort$(future_wealth < cumulative_contribution-tol_money or
 668            present_wealth > future_wealth+tol_money)
 669        "Sovereign wealth accounting check failed", m, r, h;
 670  );
 671   
 672  * Compact tables for the main presentation.
 673  swf_base_return(m,h) = swf_results(m,"r6p3",h,"future_value_USDm");
 674  swf_high_margin(r,h) = swf_results("m75",r,h,"future_value_USDm");
 675  swf_high_margin_pv(r,h) = swf_results("m75",r,h,"present_value_USDm");
 676   
 677  n_swf_cases = card(m)*card(r)*card(h);
 678   
 679  display return_value, horizon_years, swf_discount_rate, distribution_share,
 680          swf_results, swf_base_return, swf_high_margin, swf_high_margin_pv,
 681          n_swf_cases;
 682   
 683  * Do not add sovereign portfolio assets to Phase 2 economic surplus.
 684  * PV is the discounted terminal asset balance, not an incremental social NPV.
 685   
 686  * ----------------------------------------
 687  ** 10. Final Verification and Data Export
 688  * ----------------------------------------
 689   
 690  * No new economic assumptions or equilibrium solves are introduced.
 691  * Report maximum absolute residuals using the stored scenario results.
 692  * All money values are in million USD unless otherwise stated.
 693   
 694  set audit_metric "final verification statistics"
 695     /market_cases, positive_fee_cases, margin_cases, swf_cases,
 696      max_quantity_residual, max_equilibrium_residual,
 697      max_welfare_residual, max_DWL_residual, max_incidence_residual,
 698      max_profit_residual, max_net_welfare_residual,
 699      max_break_even_residual, max_swf_FV_residual, max_swf_PV_residual,
 700      positive_domestic_cases, negative_domestic_cases, neutral_domestic_cases,
 701      verification_passed/;
 702  parameter final_checks(audit_metric) "final numerical verification";
 703   
 704  final_checks("market_cases") = n_market_cases;
 705  final_checks("positive_fee_cases") = n_positive_fee_cases;
 706  final_checks("margin_cases") = n_margin_cases;
 707  final_checks("swf_cases") = n_swf_cases;
 708   
 709  final_checks("max_quantity_residual") =
 710     smax((t,s),abs(scenario_checks(t,s,"quantity_residual")));
 711  final_checks("max_equilibrium_residual") =
 712     smax((t,s),abs(scenario_checks(t,s,"equilibrium_residual")));
 713  final_checks("max_welfare_residual") =
 714     smax((t,s),abs(scenario_checks(t,s,"welfare_residual")));
 715  final_checks("max_DWL_residual") =
 716     smax((t,s),abs(scenario_checks(t,s,"DWL_residual")));
 717  final_checks("max_incidence_residual") =
 718     smax((t,s)$positive_fee(s),abs(scenario_checks(t,s,"incidence_residual")));
 719   
 720  * Check financial and net market welfare accounting across all 54 cases.
 721  final_checks("max_profit_residual") =
 722     smax((t,s,m)$positive_fee(s),abs(
 723         margin_matrix(t,s,m,"revenue_USDm")
 724       - margin_matrix(t,s,m,"operating_cost_USDm")
 725       - margin_matrix(t,s,m,"operating_profit_USDm")));
 726   
 727  final_checks("max_net_welfare_residual") =
 728     smax((t,s,m)$positive_fee(s),abs(
 729         margin_matrix(t,s,m,"net_total_surplus_USDm")
 730       - elastic_baseline(t,"total_surplus_USDm")
 731       - margin_matrix(t,s,m,"net_total_surplus_change_USDm")));
 732   
 733  final_checks("max_break_even_residual") =
 734     smax((t,s)$positive_fee(s),abs(
 735         break_even_results(t,s,"max_opex_USDm")
 736       + break_even_results(t,s,"PS_loss_USDm")
 737       - break_even_results(t,s,"revenue_USDm")));
 738   
 739  * Independently reproduce the SWF closed-form annuity by annual compounding.
 740  * Year-end deposits: balance = previous balance*(1+return) + contribution.
 741  set yr "annual compounding steps" /step1*step20/;
 742  scalar balance_check, pv_check;
 743  parameter swf_checks(m,r,h,*) "independent SWF compounding residuals";
 744   
 745  abort$(smax(h,horizon_years(h)) > card(yr) or
 746         smin(h,horizon_years(h)) < 1 or
 747         smax(h,abs(horizon_years(h)-round(horizon_years(h)))) > tol_quantity)
 748     "SWF horizon must be a whole year between 1 and 20";
 749   
 750  loop((m,r,h),
 751     balance_check = 0;
 752     loop(yr$(ord(yr) <= horizon_years(h)),
 753        balance_check = balance_check*(1+return_value(r))
 754                      + distribution_share*margin_results(m,"operating_profit_USDm");
 755     );
 756     pv_check = balance_check/(1+swf_discount_rate)**horizon_years(h);
 757     swf_checks(m,r,h,"FV_residual") =
 758        balance_check - swf_results(m,r,h,"future_value_USDm");
 759     swf_checks(m,r,h,"PV_residual") =
 760        pv_check - swf_results(m,r,h,"present_value_USDm");
 761  );
 762   
 763  final_checks("max_swf_FV_residual") =
 764     smax((m,r,h),abs(swf_checks(m,r,h,"FV_residual")));
 765  final_checks("max_swf_PV_residual") =
 766     smax((m,r,h),abs(swf_checks(m,r,h,"PV_residual")));
 767   
 768  * Classify conditional domestic surplus; frequencies are not probabilities.
 769  final_checks("positive_domestic_cases") =
 770     sum((t,s,m)$(positive_fee(s) and domestic_matrix(t,s,m) > tol_money),1);
 771  final_checks("negative_domestic_cases") =
 772     sum((t,s,m)$(positive_fee(s) and domestic_matrix(t,s,m) < -tol_money),1);
 773  final_checks("neutral_domestic_cases") =
 774     sum((t,s,m)$(positive_fee(s) and abs(domestic_matrix(t,s,m)) <= tol_money),1);
 775   
 776  abort$(final_checks("max_quantity_residual") > tol_quantity or
 777         final_checks("max_equilibrium_residual") > tol_price or
 778         final_checks("max_welfare_residual") > tol_money or
 779         final_checks("max_DWL_residual") > tol_money or
 780         final_checks("max_incidence_residual") > tol_pct or
 781         final_checks("max_profit_residual") > tol_money or
 782         final_checks("max_net_welfare_residual") > tol_money or
 783         final_checks("max_break_even_residual") > tol_money or
 784         final_checks("max_swf_FV_residual") > tol_money or
 785         final_checks("max_swf_PV_residual") > tol_money)
 786     "Final numerical verification failed", final_checks;
 787   
 788  abort$(final_checks("positive_domestic_cases")
 789       + final_checks("negative_domestic_cases")
 790       + final_checks("neutral_domestic_cases") <> n_margin_cases)
 791     "Domestic surplus scenario count failed";
 792   
 793  final_checks("verification_passed") = 1;
 794  display final_checks;
 795   
 796  * Export GDX: stored parameters, input values, and scenario definitions.
 797  * Do not use mutable result scalars left over from the scenario loops.
 798  execute_unload 'Final_results.gdx',
 799     vbar, xbar, pbar, e_s, s, t, m, r, h, positive_fee,
 800     fee_value, elastic_value, margin_value, return_value, horizon_years,
 801     swf_discount_rate, distribution_share,
 802     metric, fin_metric, be_metric, swf_metric, audit_metric,
 803     main_results, elastic_baseline, scenario_results, scenario_checks,
 804     fee_results, elastic_results, export_change_matrix, ps_loss_matrix, dwl_matrix,
 805     margin_results, margin_matrix, domestic_matrix,
 806     break_even_results, break_even_main, min_margin_matrix, max_opex_matrix,
 807     swf_results, swf_base_return, swf_high_margin, swf_high_margin_pv,
 808     swf_checks, final_checks;
 809   
 810  * Export flat CSV tables using native GAMS put statements.
 811  * One row per scenario; zero-fee incidence is explicitly marked NA.
 812  * All files are written to the GAMS working directory.
 813  file out_market /'Final_market_results.csv'/;
 814  file out_margin /'Final_margin_results.csv'/;
 815  file out_break_even /'Final_break_even_results.csv'/;
 816  file out_swf /'Final_swf_results.csv'/;
 817  file out_audit /'Final_verification.csv'/;
 818   
 819  out_market.pw = 4096;
 820  out_margin.pw = 4096;
 821  out_break_even.pw = 4096;
 822  out_swf.pw = 4096;
 823  out_audit.pw = 4096;
 824  out_audit.nr = 2;
 825  out_audit.nz = 0;
 826   
 827  * 21 market cases, including the three no-fee baselines.
 828  put out_market;
 829  put 'elasticity_case,fee_case';
 830  loop(metric, put ',' metric.tl:0;);
 831  put /;
 832  loop((t,s),
 833     put t.tl:0 ',' s.tl:0;
 834     loop(metric,
 835        put ',';
 836        if((fee_value(s) = 0) and
 837           (sameas(metric,'buyer_incidence_pct') or sameas(metric,'exporter_incidence_pct')),
 838           put 'NA';
 839        else
 840           put scenario_results(t,s,metric):0:8;
 841        );
 842     );
 843     put /;
 844  );
 845  putclose out_market;
 846   
 847  * 54 operating margin cases.
 848  put out_margin;
 849  put 'elasticity_case,fee_case,margin_case,elasticity,fee_USD_t';
 850  loop(fin_metric, put ',' fin_metric.tl:0;);
 851  put /;
 852  loop((t,s,m)$positive_fee(s),
 853     put t.tl:0 ',' s.tl:0 ',' m.tl:0 ',' elastic_value(t):0:4 ',' fee_value(s):0:4;
 854     loop(fin_metric, put ',' margin_matrix(t,s,m,fin_metric):0:8;);
 855     put /;
 856  );
 857  putclose out_margin;
 858   
 859  * 18 positive-fee domestic break-even thresholds.
 860  put out_break_even;
 861  put 'elasticity_case,fee_case';
 862  loop(be_metric, put ',' be_metric.tl:0;);
 863  put /;
 864  loop((t,s)$positive_fee(s),
 865     put t.tl:0 ',' s.tl:0;
 866     loop(be_metric, put ',' break_even_results(t,s,be_metric):0:8;);
 867     put /;
 868  );
 869  putclose out_break_even;
 870   
 871  * 27 SWF investment scenarios at the benchmark fee and elasticity.
 872  put out_swf;
 873  put 'margin_case,return_case,horizon_case,fee_USD_t,elasticity,discount_rate_pct,distribution_share_pct';
 874  loop(swf_metric, put ',' swf_metric.tl:0;);
 875  put /;
 876  loop((m,r,h),
 877     put m.tl:0 ',' r.tl:0 ',' h.tl:0 ',' fee_value('f5'):0:4 ','
 878         elastic_value('e2'):0:4 ',' (100*swf_discount_rate):0:4 ','
 879         (100*distribution_share):0:4;
 880     loop(swf_metric, put ',' swf_results(m,r,h,swf_metric):0:8;);
 881     put /;
 882  );
 883  putclose out_swf;
 884   
 885  * Final verification summary. Scientific format retains small residuals.
 886  put out_audit;
 887  put 'check,value' /;
 888  loop(audit_metric,
 889     put audit_metric.tl:0 ',' final_checks(audit_metric):0:14 /;
 890  );
 891  putclose out_audit;
 892   
