G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  ** Final Project - DSI export fee on Indonesian Ferronickel
   2  ** DSI (Danantara Sumberdaya Indonesia), a state-owned commodity export intermediary
   3  ** Prepared by Faiz Al Harkan
   4   
   5  ** One commodity, one period, competitive exporters
   6  ** X in million metric tons, prices in USD/t, surplus and revenue in million USD
   7  ** Consumer Surplus (CS) refers to surplus under foreign residual demand since assuming consumer is foreign only (importers)
   8   
   9  option decimals = 6;
  10   
  11   
  12   
  13   
  14   
  15  * ----------------------------------------
  16  ** 1. Benchmark Data and Assumptions
  17  * ----------------------------------------
  18   
  19  * Observed export value and quantity from WITS 2025 to calculate the benchmark price
  20  scalar
  21     vbar "2025 export value [million USD]" /16385.06673/
  22     xbar "2025 export quantity [Mt]" /11.5556/
  23     pbar "benchmark export price [USD/t]"
  24     e_r "residual demand elasticity" /-0.1/
  25     e_s "export supply elasticity" /0.4/
  26     fee "DSI fee [USD/t] baseline" /0/
  27     grade "common product nickel grade on FerroNickel product" /0.12/;
  28   
  29  * Elasticities are literature-informed assumptions which assumed similar between nickel and refined nickel
  30  * Demand: Shojaeddini et al (2024); supply: USGS (2025)
  31  * f denotes fee scenarios, ed denotes demand elasticity, es denotes supply elasticity, marg denotes DSI operating margin, and g denotes representative producer groups (low and high cash cost)
  32  set f /f0, f1, f3, f5, f7, f9/;
  33  set ed /ed0p1, ed0p3, ed0p5, ed1, ed2/;
  34  set es /es0p3, es0p4, es0p5, es1/;
  35  set main_ed(ed) /ed0p1, ed0p3, ed0p5/;
  36  set main_es(es) /es0p3, es0p4, es0p5/;
  37  set positive_fee(f) /f1, f3, f5, f7, f9/;
  38  set marg /m25, m50, m75/;
  39  set g "representative producer groups" /low, high/;
  40   
  41  parameter
  42     fee_value(f) /f0 0, f1 1, f3 3, f5 5, f7 7, f9 9/
  43     demand_value(ed) /ed0p1 -0.1, ed0p3 -0.3, ed0p5 -0.5, ed1 -1, ed2 -2/
  44     supply_value(es) /es0p3 0.3, es0p4 0.4, es0p5 0.5, es1 1/
  45     margin_value(marg) /m25 0.25, m50 0.50, m75 0.75/
  46     cash_cost_ni(g) "2025 weighted cash cost [USD/t paid Ni]" /low 9591.459567, high 11115.376566/
  47     cash_cost(g) "cash cost proxy [USD/t product]";
  48   
  49  * S&P Mine Economics 2025, production-weighted cash cost of six NPI smelters
  50  * Low cost smelters: Bukit, Cahaya, Oracle and Angel; High cost smelters: Hengjaya and Ranger
  51  * Common grade and full payability where costs are not marginal costs
  52  * Convert cost per ton of paid nickel into cost per ton of product
  53  cash_cost(g) = grade*cash_cost_ni(g);
  54  pbar = vbar/xbar;
  55   
  56  display vbar, xbar, pbar, e_r, e_s, cash_cost;
  57   
  58   
  59   
  60   
  61   
  62  * ----------------------------------------
  63  ** 2. Demand and Supply Calibration
  64  * ----------------------------------------
  65   
  66  * P(X) = a + bX and MC(X) = c + dX
  67  * Local linear approximation around the observed price and quantity
  68  * A supply elasticity below one implies a negative Marginal Cost (MC) intercept
  69  scalar a, b, c, d;
  70   
  71  * Calibrate linear demand and supply following simplemarket.gms
  72  * Calculate slopes using the assumed elasticities
  73  b = pbar/(e_r*xbar);
  74  d = pbar/(e_s*xbar);
  75   
  76  * Calculate intercepts so both curves pass through the benchmark
  77  a = pbar - b*xbar;
  78  c = pbar - d*xbar;
  79   
  80  display a, b, c, d;
  81   
  82   
  83   
  84   
  85   
  86  * ----------------------------------------
  87  ** 3. Benchmark Equilibrium - No DSI Fee
  88  * ----------------------------------------
  89   
  90  positive variable X "exports [Mt]";
  91  variable equilibrium_potential "equilibrium potential, not national welfare";
  92  equation objfn;
  93   
  94  * QCP objective adapted from simplemarket.gms and mrmonops.gms
  95  * The same market model is used with and without a fee
  96  * Maximize the area between demand and MC minus the fee to obtain market equilibrium
  97  objfn.. equilibrium_potential =e=
  98     a*X + b*X*X/2 - c*X - d*X*X/2 - fee*X;
  99   
 100  model market /objfn/;
 101   
 102  scalar exports_base, price_base;
 103  * Start from observed exports and solve the no-fee equilibrium
 104  fee = 0;
 105  X.l = xbar;
 106  solve market using qcp maximizing equilibrium_potential;
 107   
 108  * X.l is the equilibrium quantity and should reproduce xbar in this case
 109  exports_base = X.l;
 110  price_base = a + b*exports_base;
 111  display exports_base, price_base;
 112   
 113   
 114   
 115   
 116   
 117  * ----------------------------------------
 118  ** 4. DSI Fee Equilibrium
 119  * ----------------------------------------
 120   
 121  * The fee creates a difference between buyer price and net exporter price
 122  * Main illustrative fee is 5 USD/t
 123  scalar exports_fee, price_fee, net_price_fee, dsi_revenue_fee,
 124         change_cs, change_ps, change_ts, deadweight_loss,
 125         buyer_incidence, exporter_incidence;
 126   
 127  * Reuse the model with a changed parameter following simplemarket.gms (shock example)
 128  fee = fee_value("f5");
 129  X.l = xbar;
 130  solve market using qcp maximizing equilibrium_potential;
 131   
 132  exports_fee = X.l;
 133  price_fee = a + b*exports_fee;
 134  * Buyers pay the gross price and exporters receive the price net of the fee
 135  net_price_fee = price_fee - fee;
 136  * Fee times export volume gives gross DSI revenue in million USD
 137  dsi_revenue_fee = fee*exports_fee;
 138   
 139  * Use trapezoid areas to avoid extrapolating MC to zero output (since MC < 0 so I figured out to find the TS, CS, PS and DWL by using this formula)
 140  change_cs = (price_base-price_fee)*(exports_base+exports_fee)/2;
 141  change_ps = (net_price_fee-price_base)*(exports_base+exports_fee)/2;
 142  * Include fee revenue as a transfer before accounting for operating costs
 143  change_ts = change_cs + change_ps + dsi_revenue_fee;
 144  deadweight_loss = -change_ts;
 145  * Calculate the share of the fee paid by buyers and exporters
 146  buyer_incidence = 100*(price_fee-price_base)/fee;
 147  exporter_incidence = 100*(price_base-net_price_fee)/fee;
 148   
 149  display exports_fee, price_fee, net_price_fee, dsi_revenue_fee,
 150          change_cs, change_ps, change_ts, deadweight_loss,
 151          buyer_incidence, exporter_incidence;
 152   
 153   
 154   
 155   
 156   
 157  * ----------------------------------------
 158  ** 5. Fee and Elasticity Sensitivity
 159  * ----------------------------------------
 160   
 161  * 54 main cases including 9 no-fee cases, plus 3 stress tests
 162  * Stress tests use the main fee and more responsive buyers or suppliers
 163  * These are static comparisons or short run models, not estimated long-run elasticities
 164  * Select only the intended combinations of fee and elasticities
 165  set market_case(ed,es,f);
 166  market_case(ed,es,f) = yes$(main_ed(ed) and main_es(es));
 167  market_case("ed1","es0p4","f5") = yes;
 168  market_case("ed2","es0p4","f5") = yes;
 169  market_case("ed1","es1","f5") = yes;
 170   
 171  * Define the indicators to be calculated for each scenario
 172  set metric /fee_USD_t, demand_elasticity, supply_elasticity, exports_Mt,
 173              buyer_price_USD_t, net_price_USD_t, dsi_revenue_USDm,
 174              export_change_pct, buyer_price_change, exporter_net_price_change,
 175              change_CS_USDm, change_PS_USDm, change_TS_USDm, DWL_USDm,
 176              buyer_incidence_pct, exporter_incidence_pct/;
 177   
 178  * Store scenario results following the rep parameter in mrmonops.gms
 179  parameter scenario_results(ed,es,f,metric), fee_results(f,metric),
 180            elastic_results(ed,es,metric);
 181   
 182  * Reuse the model with different parameters as in simplemarket.gms
 183  * Run only the selected scenarios
 184  loop((ed,es,f)$market_case(ed,es,f),
 185     e_r = demand_value(ed);
 186     e_s = supply_value(es);
 187     fee = fee_value(f);
 188   
 189  *  Each elasticity pair is calibrated to the same observed benchmark
 190     b = pbar/(e_r*xbar);
 191     a = pbar - b*xbar;
 192     d = pbar/(e_s*xbar);
 193     c = pbar - d*xbar;
 194   
 195     X.l = xbar;
 196     solve market using qcp maximizing equilibrium_potential;
 197   
 198     exports_fee = X.l;
 199     price_fee = a + b*exports_fee;
 200     net_price_fee = price_fee - fee;
 201     dsi_revenue_fee = fee*exports_fee;
 202     change_cs = (pbar-price_fee)*(xbar+exports_fee)/2;
 203     change_ps = (net_price_fee-pbar)*(xbar+exports_fee)/2;
 204     change_ts = change_cs + change_ps + dsi_revenue_fee;
 205     deadweight_loss = -change_ts;
 206   
 207  *  Result storage follows the rep parameter in mrmonops.gms
 208  *  Save the outcomes and changes relative to the common no-fee benchmark
 209     scenario_results(ed,es,f,"fee_USD_t") = fee;
 210     scenario_results(ed,es,f,"demand_elasticity") = e_r;
 211     scenario_results(ed,es,f,"supply_elasticity") = e_s;
 212     scenario_results(ed,es,f,"exports_Mt") = exports_fee;
 213     scenario_results(ed,es,f,"buyer_price_USD_t") = price_fee;
 214     scenario_results(ed,es,f,"net_price_USD_t") = net_price_fee;
 215     scenario_results(ed,es,f,"dsi_revenue_USDm") = dsi_revenue_fee;
 216     scenario_results(ed,es,f,"export_change_pct") = 100*(exports_fee/xbar-1);
 217     scenario_results(ed,es,f,"buyer_price_change") = price_fee-pbar;
 218     scenario_results(ed,es,f,"exporter_net_price_change") = net_price_fee-pbar;
 219     scenario_results(ed,es,f,"change_CS_USDm") = change_cs;
 220     scenario_results(ed,es,f,"change_PS_USDm") = change_ps;
 221     scenario_results(ed,es,f,"change_TS_USDm") = change_ts;
 222     scenario_results(ed,es,f,"DWL_USDm") = deadweight_loss;
 223   
 224  *  Fee incidence is undefined at zero fee
 225     scenario_results(ed,es,f,"buyer_incidence_pct") = NA;
 226     scenario_results(ed,es,f,"exporter_incidence_pct") = NA;
 227     if(fee > 0,
 228        scenario_results(ed,es,f,"buyer_incidence_pct") = 100*(price_fee-pbar)/fee;
 229        scenario_results(ed,es,f,"exporter_incidence_pct") = 100*(pbar-net_price_fee)/fee;
 230     );
 231  );
 232   
 233  * Compare different fees while keeping elasticities constant
 234  fee_results(f,metric) = scenario_results("ed0p1","es0p4",f,metric);
 235  * Compare different elasticities while keeping the fee at 5 USD/t
 236  elastic_results(ed,es,metric)$market_case(ed,es,"f5") = scenario_results(ed,es,"f5",metric);
 237   
 238  display fee_results, elastic_results;
 239   
 240   
 241   
 242   
 243   
 244  * ----------------------------------------
 245  ** 6. DSI Operating Margin Analysis
 246  * ----------------------------------------
 247   
 248  * Operating margins are illustrative since since DSI was established in mid-2026 which unknown yet published data such as cost, revenue, and profit
 249  * Assume DSI operations create additional costs to the whole economy
 250  * Assume all producer surplus and DSI profit remain in Indonesia (domestically)
 251  * Exclude governance benefits, taxes, financing and capital expenditure
 252  * Domestic surplus is a proxy, not a complete measure of national welfare
 253  * DSI profit may contribute to Danantara's investment funds as a national SWF
 254   
 255  set fin_metric /margin_pct, revenue_USDm, operating_cost_USDm,
 256                  operating_profit_USDm, domestic_surplus_change_USDm,
 257                  net_total_surplus_change_USDm/;
 258  parameter margin_matrix(ed,es,f,marg,fin_metric), margin_results(marg,fin_metric);
 259  scalar revenue_case, cost_case, profit_case;
 260   
 261  loop((ed,es,f,marg)$(market_case(ed,es,f) and positive_fee(f)),
 262     revenue_case = scenario_results(ed,es,f,"dsi_revenue_USDm");
 263  *  Split gross revenue into operating costs and operating profit
 264     cost_case = (1-margin_value(marg))*revenue_case;
 265     profit_case = margin_value(marg)*revenue_case;
 266   
 267     margin_matrix(ed,es,f,marg,"margin_pct") = 100*margin_value(marg);
 268     margin_matrix(ed,es,f,marg,"revenue_USDm") = revenue_case;
 269     margin_matrix(ed,es,f,marg,"operating_cost_USDm") = cost_case;
 270     margin_matrix(ed,es,f,marg,"operating_profit_USDm") = profit_case;
 271  *  Compare DSI profit with the loss in exporter surplus
 272     margin_matrix(ed,es,f,marg,"domestic_surplus_change_USDm") =
 273        scenario_results(ed,es,f,"change_PS_USDm") + profit_case;
 274  *  Subtract operating costs from total market surplus change
 275     margin_matrix(ed,es,f,marg,"net_total_surplus_change_USDm") =
 276        scenario_results(ed,es,f,"change_TS_USDm") - cost_case;
 277  );
 278   
 279  margin_results(marg,fin_metric) = margin_matrix("ed0p1","es0p4","f5",marg,fin_metric);
 280  display margin_results;
 281   
 282   
 283   
 284   
 285   
 286  * ----------------------------------------
 287  ** 7. Producer Cash Margin Analysis
 288  * ----------------------------------------
 289   
 290  * Assume representative exporters face the same net product price
 291  * Hold cash cost per ton constant and use a common 12 percent nickel grade based available data from S&P Mine Economics 2025 and University of Maryland - Indonesia Nickel Smelter Database (2025)
 292  * Compare cash margin exposure, not accounting profit or producer surplus
 293  * Cash costs do not identify individual MC curves or output responses
 294  set cash_metric /cash_cost_USD_t, initial_margin_USD_t, net_price_USD_t,
 295                   cash_margin_USD_t, margin_loss_USD_t, margin_loss_pct/;
 296  parameter initial_margin(g), cash_results(ed,es,f,g,cash_metric),
 297            cash_main(g,cash_metric);
 298  scalar net_price_case, margin_loss_case;
 299   
 300  * Initial cash margin is selling price minus estimated unit cash cost
 301  initial_margin(g) = pbar - cash_cost(g);
 302   
 303  loop((ed,es,f,g)$market_case(ed,es,f),
 304     net_price_case = scenario_results(ed,es,f,"net_price_USD_t");
 305  *  Both groups face the same price reduction but have different initial margins
 306     margin_loss_case = pbar-net_price_case;
 307   
 308     cash_results(ed,es,f,g,"cash_cost_USD_t") = cash_cost(g);
 309     cash_results(ed,es,f,g,"initial_margin_USD_t") = initial_margin(g);
 310     cash_results(ed,es,f,g,"net_price_USD_t") = net_price_case;
 311     cash_results(ed,es,f,g,"cash_margin_USD_t") = net_price_case-cash_cost(g);
 312     cash_results(ed,es,f,g,"margin_loss_USD_t") = margin_loss_case;
 313     cash_results(ed,es,f,g,"margin_loss_pct") = NA;
 314  *  Calculate relative cash margin loss only when the initial margin is positive
 315     if(initial_margin(g) > 0,
 316        cash_results(ed,es,f,g,"margin_loss_pct") = 100*margin_loss_case/initial_margin(g);
 317     );
 318  );
 319   
 320  cash_main(g,cash_metric) = cash_results("ed0p1","es0p4","f5",g,cash_metric);
 321  display cash_main;
 322   
 323   
 324   
 325   
 326   
 327  * ----------------------------------------
 328  ** 8. Results and CSV Export
 329  * ----------------------------------------
 330   
 331  * GDX export follows simplemarket.gms
 332  * Export only the three result tables and compact summaries
 333  execute_unload 'Final_v07_results.gdx', vbar, xbar, pbar, grade,
 334     fee_value, demand_value, supply_value, margin_value, cash_cost_ni, cash_cost,
 335     market_case, scenario_results, fee_results, elastic_results,
 336     margin_matrix, margin_results, cash_results, cash_main;
 337   
 338  * Write each selected scenario as one CSV row with metrics in columns
 339  file out_market /'Final_v07_market.csv'/;
 340  file out_margin /'Final_v07_margin.csv'/;
 341  file out_cash /'Final_v07_cash.csv'/;
 342  out_market.pw = 4096;
 343  out_margin.pw = 4096;
 344  out_cash.pw = 4096;
 345   
 346  put out_market;
 347  put 'demand_case,supply_case,fee_case';
 348  loop(metric, put ',' metric.tl:0;);
 349  put /;
 350  loop((ed,es,f)$market_case(ed,es,f),
 351     put ed.tl:0 ',' es.tl:0 ',' f.tl:0;
 352     loop(metric, put ',' scenario_results(ed,es,f,metric):0:8;);
 353     put /;
 354  );
 355  putclose out_market;
 356   
 357  put out_margin;
 358  put 'demand_case,supply_case,fee_case,margin_case';
 359  loop(fin_metric, put ',' fin_metric.tl:0;);
 360  put /;
 361  loop((ed,es,f,marg)$(market_case(ed,es,f) and positive_fee(f)),
 362     put ed.tl:0 ',' es.tl:0 ',' f.tl:0 ',' marg.tl:0;
 363     loop(fin_metric, put ',' margin_matrix(ed,es,f,marg,fin_metric):0:8;);
 364     put /;
 365  );
 366  putclose out_margin;
 367   
 368  put out_cash;
 369  put 'demand_case,supply_case,fee_case,producer_group';
 370  loop(cash_metric, put ',' cash_metric.tl:0;);
 371  put /;
 372  loop((ed,es,f,g)$market_case(ed,es,f),
 373     put ed.tl:0 ',' es.tl:0 ',' f.tl:0 ',' g.tl:0;
 374     loop(cash_metric, put ',' cash_results(ed,es,f,g,cash_metric):0:8;);
 375     put /;
 376  );
 377  putclose out_cash;
