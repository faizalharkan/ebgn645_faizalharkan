GAMS 54.3.1  61154be4 Aug 21, 2026          DAX-DAC arm 64bit/macOS - 10/13/26 10:47:33 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  ** Milestone 2 - Direct selling versus "DSI" an Indonesian Centralized export desk on Ferronickel
   2  ** Assumption: 1 commodity, 1 period, and unit are still illustrative
   3  ** X = exports; where price is monetary units per quantity unit
   4   
   5   
   6  * ----------------------------------------
   7  ** 1. Input Values and Elasticities
   8  * ----------------------------------------
   9   
  10  scalar
  11      pbar "export price [money/unit]" /100/
  12      xbar "export quantity [unit]" /100/
  13      e_r  "residual demand elasticity [unitless]" /-2/
  14      e_s  "supply elasticity [unitless]" /1/;
  15   
  16   
  17  * ----------------------------------------
  18  ** 2. Determine inverse residual demand and marginal cost
  19  * ----------------------------------------
  20  * Price = a + b*X
  21  * MC = c + d*X
  22   
  23  scalar a, b, c, d;
  24  b = pbar / (e_r * xbar);
  25  a = pbar - b * xbar;
  26  d = pbar / (e_s * xbar);
  27  c = pbar - d * xbar;
  28   
  29  display a, b, c, d;
  30   
  31   
  32  * ----------------------------------------
  33  ** 3. Variables and objective equations
  34  * ----------------------------------------
  35   
  36  positive variable X "Indonesian exports" ;
  37   
  38  variable
  39      social_surplus "surplus objective for competitive equilibrium"
  40      profit "joint Indonesian producer/export surplus" ;
  41   
  42  equation social_surplus_max, profit_max;
  43  * Direct-selling benchmark:
  44  * producers/exporters act as price takers.
  45  * The objective is area under residual demand minus total resource cost.
  46  * Maximizing this objective gives P = MC when X > 0.
  47  * It is used as a computational device to recover the competitive equilibrium.
  48  * Its objective value is not interpreted as Indonesian or global welfare.
  49   
  50  social_surplus_max.. social_surplus =e= a*X + b*X*X/2 - c*X - d*X*X/2 ;
  51   
  52  * Centralized export desk:
  53  * the centralized desk acts as a price maker.
  54  * It maximizes export revenue minus total resource cost.
  55  * Maximizing this objective gives MR = MC when X > 0.
  56  * Profit represents joint producer/export surplus, not DSI corporate profit.
  57   
  58  profit_max.. profit =e= (a+b*X)*X - c*X - d*X*X/2 ;
  59   
  60  * where each model contrains only its own objective function, and the other is flexible to adjust.
  61   
  62  model direct_selling /social_surplus_max/ ;
  63  model centralized_desk /profit_max/ ;
  64   
  65  parameter rep "comparable results for both regimes" ;
  66   
  67  * ----------------------------------------
  68  ** 4. Simulate the direct-selling regime, where the Indonesian producers/exporters are price takers and maximize social surplus.
  69  * ----------------------------------------
  70   
  71  solve direct_selling using qcp maximizing social_surplus;
  72  rep("direct_selling","exports") = X.l ;
  73  rep("direct_selling","price") = a + b*X.l ;
  74  rep("direct_selling","revenue") = (a + b*X.l) * X.l ;
  75  rep("direct_selling","cost") = c*X.l + d*X.l*X.l/2;
  76  rep("direct_selling","producer_surplus") = rep("direct_selling","revenue") - rep("direct_selling","cost") ;
  77   
  78  display rep;
  79   
  80  * ----------------------------------------
  81  ** 5. Simulate the centralized desk regime, where the Indonesian producers/exporters are price setters and maximize joint profit.
  82  * ----------------------------------------
  83   
  84  solve centralized_desk using qcp maximizing profit;
  85  rep("centralized_desk","exports") = X.l ;
  86  rep("centralized_desk","price") = a + b*X.l ;
  87  rep("centralized_desk","revenue") = (a + b*X.l) * X.l ;
  88  rep("centralized_desk","cost") = c*X.l + d*X.l*X.l/2;
  89  rep("centralized_desk","producer_surplus") = rep("centralized_desk","revenue") - rep("centralized_desk","cost") ;
  90   
  91  display rep;
  92   


