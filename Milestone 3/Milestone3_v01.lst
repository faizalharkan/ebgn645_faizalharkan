GAMS 54.3.1  61154be4 Aug 21, 2026          DAX-DAC arm 64bit/macOS - 11/19/26 22:25:31 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1   
   2  ** Milestone 3 - DSI export fee on Indonesian Ferronickel
   3  ** Assumption: 1 commodity, 1 period, competitive exporters
   4  ** Using 2025 export data; elasticities and fees are assumed
   5  ** X = exports (million tons); P = USD per ton of product
   6  ** Revenue, cost, and profit are in million USD
   7   
   8   
   9  * ----------------------------------------
  10  ** 1. Input Values and Elasticities
  11  * ----------------------------------------
  12   
  13  scalar
  14      vbar "2025 export value [million USD]" /16385.06673/
  15      xbar "2025 export quantity [million tons]" /11.5556/
  16      pbar "average export price [USD/ton]"
  17      e_r  "residual demand elasticity [unitless]" /-2/
  18      e_s  "supply elasticity [unitless]" /1/;
  19   
  20  * Average price from 2025 export data
  21  pbar = vbar / xbar;
  22   
  23  display vbar, xbar, pbar, e_r, e_s;
  24   
  25   
  26  * ----------------------------------------
  27  ** 2. Determine Inverse Residual Demand and Marginal Cost
  28  * ----------------------------------------
  29   
  30  * P(X) = a + bX
  31  * MC(X) = c + dX
  32   
  33  scalar
  34      a "demand intercept"
  35      b "demand slope"
  36      c "marginal cost intercept"
  37      d "marginal cost slope";
  38   
  39  * Calibrate using price, quantity, and elasticities
  40  b = pbar / (e_r* xbar);
  41  a = pbar - b * xbar;
  42   
  43  d = pbar / (e_s * xbar);
  44  c = pbar - d * xbar;
  45   
  46  display a, b, c, d;
  47   
  48   
  49  * ----------------------------------------
  50  ** 3. Direct Selling - No Fee
  51  * ----------------------------------------
  52   
  53  * Competitive market, where P = MC
  54   
  55  positive variable X "export quantity";
  56  variable social_surplus "total market surplus";
  57   
  58  equation eq_surplus;
  59   
  60  eq_surplus..
  61      social_surplus =e=
  62        a*X + 0.5*b*sqr(X)
  63      - c*X - 0.5*d*sqr(X);
  64   
  65  model direct_selling /eq_surplus/;
  66   
  67  X.l = xbar;
  68   
  69  solve direct_selling using qcp maximizing social_surplus;
  70   
  71  * Calculate price and exporter surplus
  72  scalar
  73      price_base
  74      exporter_surplus_base;
  75   
  76  price_base = a + b*X.l;
  77  exporter_surplus_base = price_base*X.l
  78                       - (c*X.l + 0.5*d*sqr(X.l));
  79   
  80  display X.l, price_base, exporter_surplus_base;
  81   
  82   
  83   
  84  * ----------------------------------------
  85  ** 4. Direct Selling - With DSI Fee
  86  * ----------------------------------------
  87   
  88  * Exporters pay the fee to DSI for export monitoring and verification
  89  * DSI revenue is not the same as DSI profit
  90   
  91  scalar fee "DSI fee [USD/ton]" /5/;
  92   
  93  equation eq_fee;
  94   
  95  eq_fee..
  96      social_surplus =e=
  97        a*X + 0.5*b*sqr(X)
  98      - c*X - 0.5*d*sqr(X)
  99      - fee*X;
 100   
 101  model with_dsi_fee /eq_fee/;
 102   
 103  X.l = xbar;
 104   
 105  solve with_dsi_fee using qcp maximizing social_surplus;
 106   
 107  * Calculate price, exporter surplus, and DSI revenue
 108  scalar
 109      price_fee
 110      net_price_fee
 111      exporter_surplus_fee
 112      dsi_revenue_fee
 113      check_eq;
 114   
 115  price_fee = a + b*X.l;
 116  net_price_fee = price_fee - fee;
 117   
 118  exporter_surplus_fee = net_price_fee*X.l
 119                       - (c*X.l + 0.5*d*sqr(X.l));
 120   
 121  dsi_revenue_fee = fee*X.l;
 122   
 123  * Check if P - fee = MC
 124  check_eq = net_price_fee - (c + d*X.l);
 125   
 126  display X.l, price_fee, net_price_fee,
 127          exporter_surplus_fee, dsi_revenue_fee, check_eq;
 128   
 129   
 130   
 131  * ----------------------------------------
 132  ** 5. Fee Sensitivity Analysis
 133  * ----------------------------------------
 134   
 135  * Test different DSI fees using the same demand and supply curves
 136   
 137  set s "fee scenarios"
 138      /f0, f0p5, f1, f3, f5, f7, f9/;
 139   
 140  parameter fee_value(s) "DSI fee [USD/ton]"
 141      /f0   0
 142       f0p5 0.5
 143       f1   1
 144       f3   3
 145       f5   5
 146       f7   7
 147       f9   9/;
 148   
 149  parameter fee_results(s,*) "results for each fee scenario";
 150   
 151  loop(s,
 152   
 153      fee = fee_value(s);
 154      X.l = xbar;
 155   
 156      solve with_dsi_fee using qcp maximizing social_surplus;
 157   
 158      price_fee = a + b*X.l;
 159      net_price_fee = price_fee - fee;
 160   
 161      exporter_surplus_fee = net_price_fee*X.l
 162                           - (c*X.l + 0.5*d*sqr(X.l));
 163   
 164      dsi_revenue_fee = fee*X.l;
 165   
 166      fee_results(s,"fee") = fee;
 167      fee_results(s,"exports_Mt") = X.l;
 168      fee_results(s,"price_USD_t") = price_fee;
 169      fee_results(s,"net_price_USD_t") = net_price_fee;
 170      fee_results(s,"exporter_surplus_USDm") = exporter_surplus_fee;
 171      fee_results(s,"dsi_revenue_USDm") = dsi_revenue_fee;
 172   
 173  *Changes relative to the no-fee baseline
 174      fee_results(s,"export_change_pct") = 100*(X.l/xbar - 1);
 175      fee_results(s,"buyer_price_change") = price_fee - price_base;
 176      fee_results(s,"exporter_net_price_change") =
 177          net_price_fee - price_base;
 178   
 179  );
 180   
 181  display fee_results;
 182   
 183   
 184   
 185   
 186  * ----------------------------------------
 187  ** 6. Demand Elasticity Sensitivity Analysis
 188  * ----------------------------------------
 189   
 190  * Keep DSI fee at USD 5/ton
 191  * Test different foreign demand elasticities
 192   
 193  fee = 5;
 194   
 195  set t "elasticity scenarios"
 196      /e1, e2, e4/;
 197   
 198  parameter elastic_value(t) "residual demand elasticity"
 199      /e1 -1
 200       e2 -2
 201       e4 -4/;
 202   
 203  parameter elastic_results(t,*) "elasticity sensitivity results";
 204   
 205  loop(t,
 206   
 207      e_r = elastic_value(t);
 208   
 209  *Recalibrate demand for each elasticity
 210      b = pbar / (e_r * xbar);
 211      a = pbar - b*xbar;
 212   
 213      X.l = xbar;
 214   
 215      solve with_dsi_fee using qcp maximizing social_surplus;
 216   
 217      price_fee = a + b*X.l;
 218      net_price_fee = price_fee - fee;
 219   
 220      exporter_surplus_fee = net_price_fee*X.l
 221                           - (c*X.l + 0.5*d*sqr(X.l));
 222   
 223      dsi_revenue_fee = fee*X.l;
 224   
 225      elastic_results(t,"elasticity") = e_r;
 226      elastic_results(t,"exports_Mt") = X.l;
 227      elastic_results(t,"buyer_price_USD_t") = price_fee;
 228      elastic_results(t,"net_exporter_USD_t") = net_price_fee;
 229      elastic_results(t,"exporter_surplus_USDm") = exporter_surplus_fee;
 230      elastic_results(t,"dsi_revenue_USDm") = dsi_revenue_fee;
 231      elastic_results(t,"export_change_pct") = 100*(X.l/xbar - 1);
 232      elastic_results(t,"buyer_price_change") = price_fee - pbar;
 233   
 234  );
 235   
 236  display elastic_results;
 237   
 238  * Restore the main elasticity assumption
 239  e_r = -2;
 240  b = pbar / (e_r * xbar);
 241  a = pbar - b*xbar;
 242   
 243   
 244   
 245  * ----------------------------------------
 246  ** 7. DSI Operating Margin Sensitivity
 247  * ----------------------------------------
 248   
 249  * Assume DSI operating margins of 25%, 50%, and 75%
 250  * Use the DSI revenue from the USD 5/ton fee scenario
 251   
 252  set m "DSI margin scenarios"
 253      /m25, m50, m75/;
 254   
 255  parameter margin_value(m) "DSI operating margin"
 256      /m25 0.25
 257       m50 0.50
 258       m75 0.75/;
 259   
 260  parameter margin_results(m,*) "DSI operating cost and profit";
 261   
 262  scalar revenue_f5 "DSI revenue at USD 5/ton";
 263   
 264  revenue_f5 = fee_results("f5","dsi_revenue_USDm");
 265   
 266  loop(m,
 267   
 268      margin_results(m,"margin_pct") = 100*margin_value(m);
 269      margin_results(m,"revenue_USDm") = revenue_f5;
 270      margin_results(m,"operating_cost_USDm") =
 271          revenue_f5*(1 - margin_value(m));
 272      margin_results(m,"operating_profit_USDm") =
 273          revenue_f5*margin_value(m);
 274   
 275  );
 276   
 277  display margin_results;
 278   
 279   
 280   
EXIT /Users/alharkan/Documents/GitHub/ebgn645_faizalharkan/Milestone 3/Milestone3_v01.gms
