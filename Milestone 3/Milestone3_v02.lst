GAMS 54.3.1  61154be4 Aug 21, 2026          DAX-DAC arm 64bit/macOS - 11/20/26 11:34:49 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1   
   2  ** Milestone 3 - DSI export fee on Indonesian Ferronickel
   3  ** Assumption: 1 commodity, 1 period, competitive exporters
   4  ** Using 2025 export data; elasticities and fees are assumed
   5  ** X = exports (million tons); P = USD per ton of product
   6  ** Revenue, cost, and profit are in million USD
   7  ** version 2
   8   
   9  * ----------------------------------------
  10  ** 1. Input Values and Elasticities
  11  * ----------------------------------------
  12   
  13  scalar
  14      vbar "2025 export value [million USD]" /16385.06673/
  15      xbar "2025 export quantity [million tons]" /11.5556/
  16      pbar "average export price [USD/ton]"
  17      e_r  "residual demand elasticity [unitless]" /-2/
  18      e_s  "supply elasticity [unitless]" /1/;
  19   
  20  * Average price from 2025 export data
  21  pbar = vbar / xbar;
  22   
  23  display vbar, xbar, pbar, e_r, e_s;
  24   
  25   
  26  * ----------------------------------------
  27  ** 2A. Determine Inverse Residual Demand and Marginal Cost
  28  * ----------------------------------------
  29   
  30  * P(X) = a + bX
  31  * MC(X) = c + dX
  32   
  33  scalar
  34      a "demand intercept"
  35      b "demand slope"
  36      c "marginal cost intercept"
  37      d "marginal cost slope";
  38   
  39  * Calibrate using price, quantity, and elasticities
  40  b = pbar / (e_r* xbar);
  41  a = pbar - b * xbar;
  42   
  43  d = pbar / (e_s * xbar);
  44  c = pbar - d * xbar;
  45   
  46  display a, b, c, d;
  47   
  48   
  49   
  50  * ----------------------------------------
  51  ** 2B. Two Producer Types - Cost Calibration
  52  * ----------------------------------------
  53   
  54  * Two representative NPI producer types, adopted from S&P Capital IQ Pro for Indonesian Nickel Producers identified producing FeNi/NPI (HS: 720260) in 2025
  55  * Cash costs are illustrative estimates based on 2025 producer data and callibrated based on reported grade Ni in FeNi/NPI production
  56  * All quantities are in million tons of product
  57   
  58  set i "producer types"
  59      /low, high/;
  60   
  61  parameter
  62      share(i)      "assumed baseline export share"
  63      ac_target(i)  "average cash cost [USD/ton product]"
  64      qbar(i)       "baseline exports by producer [million tons]"
  65      c_type(i)     "marginal cost intercept"
  66      d_type(i)     "marginal cost slope"
  67      mc_check(i)   "marginal cost at baseline"
  68      ac_check(i)   "average cost at baseline";
  69   
  70  * Initial assumptions
  71  share("low")  = 0.50;
  72  share("high") = 0.50;
  73   
  74  ac_target("low")  = 1150;
  75  ac_target("high") = 1330;
  76   
  77  * Allocate baseline exports
  78  qbar(i) = xbar * share(i);
  79   
  80  * Calibrate linear marginal cost for each producer
  81  * MC_i = c_i + d_i * q_i
  82  * AC_i = c_i + 0.5 * d_i * q_i
  83   
  84  d_type(i) = 2 * (pbar - ac_target(i)) / qbar(i);
  85  c_type(i) = pbar - d_type(i) * qbar(i);
  86   
  87  * Check calibration at baseline
  88  mc_check(i) = c_type(i) + d_type(i) * qbar(i);
  89  ac_check(i) = c_type(i) + 0.5 * d_type(i) * qbar(i);
  90   
  91  display share, ac_target, qbar,
  92          c_type, d_type, mc_check, ac_check;
  93   
  94   
  95   
  96  * ----------------------------------------
  97  ** 3. Direct Selling - No Fee
  98  * ----------------------------------------
  99   
 100  * Competitive market, where P = MC
 101   
 102  positive variable X "export quantity";
 103  variable social_surplus "total market surplus";
 104   
 105  equation eq_surplus;
 106   
 107  eq_surplus..
 108      social_surplus =e=
 109        a*X + 0.5*b*sqr(X)
 110      - c*X - 0.5*d*sqr(X);
 111   
 112  model direct_selling /eq_surplus/;
 113   
 114  X.l = xbar;
 115   
 116  solve direct_selling using qcp maximizing social_surplus;
 117   
 118  * Calculate price and exporter surplus
 119  scalar
 120      price_base
 121      exporter_surplus_base;
 122   
 123  price_base = a + b*X.l;
 124  exporter_surplus_base = price_base*X.l
 125                       - (c*X.l + 0.5*d*sqr(X.l));
 126   
 127  display X.l, price_base, exporter_surplus_base;
 128   
 129   
 130   
 131  * ----------------------------------------
 132  ** 4. Direct Selling - With DSI Fee
 133  * ----------------------------------------
 134   
 135  * Exporters pay the fee to DSI for export monitoring and verification
 136  * DSI revenue is not the same as DSI profit
 137   
 138  scalar fee "DSI fee [USD/ton]" /5/;
 139   
 140  equation eq_fee;
 141   
 142  eq_fee..
 143      social_surplus =e=
 144        a*X + 0.5*b*sqr(X)
 145      - c*X - 0.5*d*sqr(X)
 146      - fee*X;
 147   
 148  model with_dsi_fee /eq_fee/;
 149   
 150  X.l = xbar;
 151   
 152  solve with_dsi_fee using qcp maximizing social_surplus;
 153   
 154  * Calculate price, exporter surplus, and DSI revenue
 155  scalar
 156      price_fee
 157      net_price_fee
 158      exporter_surplus_fee
 159      dsi_revenue_fee
 160      check_eq;
 161   
 162  price_fee = a + b*X.l;
 163  net_price_fee = price_fee - fee;
 164   
 165  exporter_surplus_fee = net_price_fee*X.l
 166                       - (c*X.l + 0.5*d*sqr(X.l));
 167   
 168  dsi_revenue_fee = fee*X.l;
 169   
 170  * Check if P - fee = MC
 171  check_eq = net_price_fee - (c + d*X.l);
 172   
 173  display X.l, price_fee, net_price_fee,
 174          exporter_surplus_fee, dsi_revenue_fee, check_eq;
 175   
 176   
 177   
 178  * ----------------------------------------
 179  ** 5. Fee Sensitivity Analysis
 180  * ----------------------------------------
 181   
 182  * Test different DSI fees using the same demand and supply curves
 183   
 184  set s "fee scenarios"
 185      /f0, f0p5, f1, f3, f5, f7, f9/;
 186   
 187  parameter fee_value(s) "DSI fee [USD/ton]"
 188      /f0   0
 189       f0p5 0.5
 190       f1   1
 191       f3   3
 192       f5   5
 193       f7   7
 194       f9   9/;
 195   
 196  parameter fee_results(s,*) "results for each fee scenario";
 197   
 198  loop(s,
 199   
 200      fee = fee_value(s);
 201      X.l = xbar;
 202   
 203      solve with_dsi_fee using qcp maximizing social_surplus;
 204   
 205      price_fee = a + b*X.l;
 206      net_price_fee = price_fee - fee;
 207   
 208      exporter_surplus_fee = net_price_fee*X.l
 209                           - (c*X.l + 0.5*d*sqr(X.l));
 210   
 211      dsi_revenue_fee = fee*X.l;
 212   
 213      fee_results(s,"fee") = fee;
 214      fee_results(s,"exports_Mt") = X.l;
 215      fee_results(s,"price_USD_t") = price_fee;
 216      fee_results(s,"net_price_USD_t") = net_price_fee;
 217      fee_results(s,"exporter_surplus_USDm") = exporter_surplus_fee;
 218      fee_results(s,"dsi_revenue_USDm") = dsi_revenue_fee;
 219   
 220  *Changes relative to the no-fee baseline
 221      fee_results(s,"export_change_pct") = 100*(X.l/xbar - 1);
 222      fee_results(s,"buyer_price_change") = price_fee - price_base;
 223      fee_results(s,"exporter_net_price_change") =
 224          net_price_fee - price_base;
 225   
 226  );
 227   
 228  display fee_results;
 229   
 230   
 231   
 232   
 233  * ----------------------------------------
 234  ** 6. Demand Elasticity Sensitivity Analysis
 235  * ----------------------------------------
 236   
 237  * Keep DSI fee at USD 5/ton
 238  * Test different foreign demand elasticities
 239   
 240  fee = 5;
 241   
 242  set t "elasticity scenarios"
 243      /e1, e2, e4/;
 244   
 245  parameter elastic_value(t) "residual demand elasticity"
 246      /e1 -1
 247       e2 -2
 248       e4 -4/;
 249   
 250  parameter elastic_results(t,*) "elasticity sensitivity results";
 251   
 252  loop(t,
 253   
 254      e_r = elastic_value(t);
 255   
 256  *Recalibrate demand for each elasticity
 257      b = pbar / (e_r * xbar);
 258      a = pbar - b*xbar;
 259   
 260      X.l = xbar;
 261   
 262      solve with_dsi_fee using qcp maximizing social_surplus;
 263   
 264      price_fee = a + b*X.l;
 265      net_price_fee = price_fee - fee;
 266   
 267      exporter_surplus_fee = net_price_fee*X.l
 268                           - (c*X.l + 0.5*d*sqr(X.l));
 269   
 270      dsi_revenue_fee = fee*X.l;
 271   
 272      elastic_results(t,"elasticity") = e_r;
 273      elastic_results(t,"exports_Mt") = X.l;
 274      elastic_results(t,"buyer_price_USD_t") = price_fee;
 275      elastic_results(t,"net_exporter_USD_t") = net_price_fee;
 276      elastic_results(t,"exporter_surplus_USDm") = exporter_surplus_fee;
 277      elastic_results(t,"dsi_revenue_USDm") = dsi_revenue_fee;
 278      elastic_results(t,"export_change_pct") = 100*(X.l/xbar - 1);
 279      elastic_results(t,"buyer_price_change") = price_fee - pbar;
 280   
 281  );
 282   
 283  display elastic_results;
 284   
 285  * Restore the main elasticity assumption
 286  e_r = -2;
 287  b = pbar / (e_r * xbar);
 288  a = pbar - b*xbar;
 289   
 290   
 291   
 292  * ----------------------------------------
 293  ** 7. DSI Operating Margin Sensitivity
 294  * ----------------------------------------
 295   
 296  * Assume DSI operating margins of 25%, 50%, and 75%
 297  * Use the DSI revenue from the USD 5/ton fee scenario
 298   
 299  set m "DSI margin scenarios"
 300      /m25, m50, m75/;
 301   
 302  parameter margin_value(m) "DSI operating margin"
 303      /m25 0.25
 304       m50 0.50
 305       m75 0.75/;
 306   
 307  parameter margin_results(m,*) "DSI operating cost and profit";
 308   
 309  scalar revenue_f5 "DSI revenue at USD 5/ton";
 310   
 311  revenue_f5 = fee_results("f5","dsi_revenue_USDm");
 312   
 313  loop(m,
 314   
 315      margin_results(m,"margin_pct") = 100*margin_value(m);
 316      margin_results(m,"revenue_USDm") = revenue_f5;
 317      margin_results(m,"operating_cost_USDm") =
 318          revenue_f5*(1 - margin_value(m));
 319      margin_results(m,"operating_profit_USDm") =
 320          revenue_f5*margin_value(m);
 321   
 322  );
 323   
 324  display margin_results;
 325   
 326   
 327   
 328  * ----------------------------------------
 329  ** 8. Two Producer Types - Baseline Equilibrium
 330  * ----------------------------------------
 331   
 332  * Both producers face the same export market price
 333  * Each producer has a different marginal cost function
 334  * No DSI fee in this first test
 335   
 336  positive variable Q2(i) "exports by producer type [million tons]";
 337  variable obj_two "competitive equilibrium potential";
 338   
 339  equation eq_obj_two;
 340   
 341  eq_obj_two..
 342      obj_two =e=
 343        a*sum(i,Q2(i))
 344      + 0.5*b*sqr(sum(i,Q2(i)))
 345      - sum(i, c_type(i)*Q2(i)
 346             + 0.5*d_type(i)*sqr(Q2(i)));
 347   
 348  model two_type_base /eq_obj_two/;
 349   
 350  * Initialize exports at calibrated baseline
 351  Q2.l(i) = qbar(i);
 352   
 353  solve two_type_base using qcp maximizing obj_two;
 354   
 355  * Calculate equilibrium outcomes
 356  scalar
 357      exports_two
 358      price_two
 359      quantity_gap_two
 360      price_gap_two;
 361   
 362  parameter
 363      mc_two(i) "marginal cost by type"
 364      eq_gap_two(i) "price minus marginal cost";
 365   
 366  exports_two = sum(i,Q2.l(i));
 367  price_two   = a + b*exports_two;
 368   
 369  mc_two(i) = c_type(i) + d_type(i)*Q2.l(i);
 370  eq_gap_two(i) = price_two - mc_two(i);
 371   
 372  * Check against observed WITS benchmark
 373  quantity_gap_two = exports_two - xbar;
 374  price_gap_two = price_two - pbar;
 375   
 376  display Q2.l, exports_two, price_two,
 377          mc_two, eq_gap_two,
 378          quantity_gap_two, price_gap_two;
 379   
 380   
 381   
 382  * ----------------------------------------
 383  ** 9. Two Producer Types - With DSI Fee
 384  * ----------------------------------------
 385   
 386  * Both producer types pay the same DSI fee
 387  * Fee is USD per ton of exported NPI
 388   
 389  fee = 5;
 390   
 391  equation eq_obj_two_fee;
 392   
 393  eq_obj_two_fee..
 394      obj_two =e=
 395        a*sum(i,Q2(i))
 396      + 0.5*b*sqr(sum(i,Q2(i)))
 397      - sum(i, c_type(i)*Q2(i)
 398             + 0.5*d_type(i)*sqr(Q2(i)))
 399      - fee*sum(i,Q2(i));
 400   
 401  model two_type_fee /eq_obj_two_fee/;
 402   
 403  * Start from the calibrated baseline
 404  Q2.l(i) = qbar(i);
 405   
 406  solve two_type_fee using qcp maximizing obj_two;
 407   
 408  * Calculate market outcomes
 409  scalar
 410      exports_two_fee
 411      price_two_fee
 412      net_price_two_fee
 413      dsi_revenue_two_fee;
 414   
 415  parameter
 416      q_fee_two(i)             "exports by producer [Mt]"
 417      mc_fee_two(i)            "marginal cost [USD/ton]"
 418      eq_gap_fee_two(i)        "net price minus marginal cost"
 419      exporter_surplus_two(i)  "producer surplus [million USD]"
 420      export_change_two(i)    "export change from baseline [%]";
 421   
 422  exports_two_fee = sum(i,Q2.l(i));
 423   
 424  price_two_fee = a + b*exports_two_fee;
 425   
 426  net_price_two_fee = price_two_fee - fee;
 427   
 428  dsi_revenue_two_fee = fee*exports_two_fee;
 429   
 430  * Producer-specific results
 431  q_fee_two(i) = Q2.l(i);
 432   
 433  mc_fee_two(i) = c_type(i) + d_type(i)*Q2.l(i);
 434   
 435  eq_gap_fee_two(i) = net_price_two_fee - mc_fee_two(i);
 436   
 437  exporter_surplus_two(i) =
 438      net_price_two_fee*Q2.l(i)
 439      - (c_type(i)*Q2.l(i)
 440      + 0.5*d_type(i)*sqr(Q2.l(i)));
 441   
 442  export_change_two(i) =
 443      100*(Q2.l(i)/qbar(i) - 1);
 444   
 445  display q_fee_two, exports_two_fee,
 446          price_two_fee, net_price_two_fee,
 447          dsi_revenue_two_fee,
 448          mc_fee_two, eq_gap_fee_two,
 449          exporter_surplus_two, export_change_two;
 450   
 451   
 452   
 453  * ----------------------------------------
 454  ** 10. Two Producer Types - Fee Sensitivity
 455  * ----------------------------------------
 456   
 457  * Small fees: policy scenarios
 458  * Large fees: hypothetical stress tests
 459   
 460  set u "two-type fee scenarios"
 461      /f0, f0p5, f1, f3, f5, f7, f9,
 462       f50, f100, f200, f400, f600, f650, f800/;
 463   
 464  parameter fee_test(u) "DSI fee [USD/ton]"
 465      /f0   0
 466       f0p5 0.5
 467       f1   1
 468       f3   3
 469       f5   5
 470       f7   7
 471       f9   9
 472       f50  50
 473       f100 100
 474       f200 200
 475       f400 400
 476       f600 600
 477       f650 650
 478       f800 800/;
 479   
 480  parameter
 481      results_two(u,*)      "market results"
 482      exports_type(u,i)    "exports by type [Mt]"
 483      surplus_type(u,i)    "producer surplus [million USD]"
 484      kkt_check(u,i)       "equilibrium condition violation";
 485   
 486  loop(u,
 487   
 488      fee = fee_test(u);
 489   
 490      Q2.l(i) = qbar(i);
 491   
 492      solve two_type_fee using qcp maximizing obj_two;
 493   
 494      exports_two_fee = sum(i,Q2.l(i));
 495      price_two_fee = a + b*exports_two_fee;
 496      net_price_two_fee = price_two_fee - fee;
 497   
 498  * Market-level results
 499      results_two(u,"fee") = fee;
 500      results_two(u,"exports_Mt") = exports_two_fee;
 501      results_two(u,"buyer_price") = price_two_fee;
 502      results_two(u,"net_price") = net_price_two_fee;
 503      results_two(u,"DSI_revenue") = fee*exports_two_fee;
 504   
 505      results_two(u,"export_change_pct") =
 506          100*(exports_two_fee/xbar - 1);
 507   
 508      results_two(u,"model_status") = two_type_fee.modelstat;
 509      results_two(u,"solver_status") = two_type_fee.solvestat;
 510   
 511  * Producer-level results
 512      exports_type(u,i) = Q2.l(i);
 513   
 514      surplus_type(u,i) =
 515          net_price_two_fee*Q2.l(i)
 516          - c_type(i)*Q2.l(i)
 517          - 0.5*d_type(i)*sqr(Q2.l(i));
 518   
 519  * For active producers, net price must equal MC
 520      kkt_check(u,i) =
 521          abs(net_price_two_fee
 522          - (c_type(i) + d_type(i)*Q2.l(i)));
 523   
 524  * For inactive producers, net price must not exceed MC(0)
 525      kkt_check(u,i)$(Q2.l(i) < 1e-6) =
 526          max(0, net_price_two_fee - c_type(i));
 527   
 528  );
 529   
 530  display results_two, exports_type,
 531          surplus_type, kkt_check;
 532   
 533  * Restore the reference fee
 534  fee = 5;
 535   
 536   
 537   
 538   
